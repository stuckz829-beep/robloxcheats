local function updateProxyCollision()
    if not hrp or not humanoid then return end
    if holdingFootball() then
        for i = 1, #cachedPlayers do
            local p = cachedPlayers[i]
            if p ~= localPlayer then
                local proxy = headProxies[p]
                if proxy and proxy.Parent and proxy.CanCollide then
                    proxy.CanCollide = false
                end
                local head = headCache[p]
                if head then proxyEngaged[head] = nil end
            end
        end
        return
    end
    if autoRushBlocksHeadTech() then
        for i = 1, #cachedPlayers do
            local p = cachedPlayers[i]
            if p ~= localPlayer then
                local proxy = headProxies[p]
                if proxy and proxy.Parent and proxy.CanCollide then
                    proxy.CanCollide = false
                end
                local head = headCache[p]
                if head then proxyEngaged[head] = nil end
            end
        end
        return
    end

    local now = tick()
    local jumpedRecently = (now - lastJumpRequestAt) <= JUMP_ATTACH_WINDOW

    for i = 1, #cachedPlayers do
        local p = cachedPlayers[i]
        if p ~= localPlayer then
            local proxy = headProxies[p]
            local head = headCache[p]
            if proxy and proxy.Parent and head and head.Parent then
                proxy.Size = head.Size
                proxy.CFrame = head.CFrame
                local engaged = proxyEngaged[head] == true
                local overTight = feetOverHead(head, PROXY_FOOTPRINT_PAD, PROXY_FEET_ABOVE_TOLERANCE)
                local overLoose = feetOverHead(head, PROXY_ENGAGED_PAD, PROXY_FEET_ABOVE_TOLERANCE)
                local solid = false
                if engaged then
                    if overLoose then solid = true else proxyEngaged[head] = nil end
                else
                    if overTight and jumpedRecently then
                        proxyEngaged[head] = true
                        solid = true
                    end
                end
                if proxy.CanCollide ~= solid then proxy.CanCollide = solid end
            end
        end
    end
end

