local function destroyHeadProxy(player)
    local proxy = headProxies[player]
    if proxy then
        pcall(function() proxy:Destroy() end)
        headProxies[player] = nil
    end
end

local function destroyAllHeadProxies()
    for player, _ in pairs(headProxies) do
        destroyHeadProxy(player)
    end
end

local function ensureHeadProxy(player, head)
    if not head or not head.Parent then
        destroyHeadProxy(player)
        return
    end
    if not (isHeadModEnabled or stickyHeadEnabled) then
        destroyHeadProxy(player)
        return
    end
    local proxy = headProxies[player]
    if not proxy or not proxy.Parent then
        proxy = Instance.new("Part")
        proxy.Name = "UFH_HeadProxy"
        proxy.Transparency = 1
        proxy.Anchored = true
        proxy.CanCollide = false
        proxy.CanQuery = false
        proxy.CanTouch = false
        proxy.Massless = true
        proxy.Locked = true
        proxy.CastShadow = false
        proxy.TopSurface = Enum.SurfaceType.Smooth
        proxy.BottomSurface = Enum.SurfaceType.Smooth
        proxy.Parent = workspace
        headProxies[player] = proxy
    end
    proxy.Size = head.Size
    proxy.CFrame = head.CFrame
end

