local function installThrowWatch(char)
    if not char then return end
    if lastCarrierForThrowWatch == char and carrierThrowConn then return end
    clearThrowWatch()
    lastCarrierForThrowWatch = char

    carrierThrowConn = char.ChildRemoved:Connect(function(child)
        if not alive then return end
        if child.Name ~= FOOTBALL_NAME then return end
        local bp = ballPos(child)
