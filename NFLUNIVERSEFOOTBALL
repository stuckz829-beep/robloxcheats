local wallRayParams = nil
local function wallAhead(dir, dist)
    if not hrp then return false end
    local flat = Vector3.new(dir.X, 0, dir.Z)
    if flat.Magnitude < 0.05 then return false end
    flat = flat.Unit

    if not wallRayParams then
        wallRayParams = RaycastParams.new()
        wallRayParams.FilterType = Enum.RaycastFilterType.Exclude
        wallRayParams.IgnoreWater = true
    end
    local ignore = {}
    local myChar = localPlayer.Character
    if myChar then
        for _, d in ipairs(myChar:GetDescendants()) do
            if d:IsA("BasePart") then ignore[#ignore + 1] = d end
        end
    end
    wallRayParams.FilterDescendantsInstances = ignore

    local origin = hrp.Position
    local hit = workspace:Raycast(origin, flat * dist, wallRayParams)
    return hit ~= nil
end

