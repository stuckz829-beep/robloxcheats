-------------------------------------------------
-- MAIN HEARTBEAT
-------------------------------------------------
track(RunService.Heartbeat:Connect(function(dt)
    if not alive then return end
    if not hrp or not humanoid then return end
    if refreshPinning then return end

    if isRagdolled() then
        if stickyTarget then detachSticky() end
        if autoRushActive then stopActiveRush() end
        humanoid:Move(V3_ZERO, false)
        flyVelocity = V3_ZERO
        diveLockedDir = nil
        jumpBoostHoldUntil = 0
        jumpBoostHoldVelocity = 0
        lastMyPos = hrp.Position
        updateProxyCollision()
        return
    end

    if workspace.Gravity ~= gravityVal then workspace.Gravity = gravityVal end
    if stickyCooldown > 0 then stickyCooldown = math.max(0, stickyCooldown - dt) end
    if jumpBoostStickyCooldown > 0 then jumpBoostStickyCooldown = math.max(0, jumpBoostStickyCooldown - dt) end

    local now = tick()
    local jumpedRecently = (now - lastJumpRequestAt) <= JUMP_ATTACH_WINDOW

    enforceWalkSpeed()

    if autoRushActive and not autoRushAllowed() then
        stopActiveRush()
        Rayfield:Notify({Title="Auto Rush", Content="Off (WalkSpeed < 21)", Duration=3})
    end

    if lastMyPos then
        local jumped = (hrp.Position - lastMyPos).Magnitude > TELEPORT_THRESHOLD
        if jumped then
            if stickyTarget then detachSticky() end
            jumpBoostHoldUntil = 0
            jumpBoostHoldVelocity = 0
            stickyAnchorPos = nil
            stickyLastTargetHeadPos = nil
            stickyAttachStartPos = nil
            for k in pairs(proxyEngaged) do proxyEngaged[k] = nil end
        end
    end
    lastMyPos = hrp.Position

    if isHoldingSideTech and sideTechTargetLookVector
       and not isShiftLocked()
       and not sideTechAnimPlaying then
        local vel = hrp.AssemblyLinearVelocity
        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + sideTechTargetLookVector)
        hrp.AssemblyLinearVelocity = vel
    end

    if sideTechAnimPlaying and not prevDiveState then
        local dir
        if autoRushActive then
            local targetPos = rushTargetPos()
            if targetPos then
                local diff = targetPos - hrp.Position
                local flat = Vector3.new(diff.X, 0, diff.Z)
                if flat.Magnitude > 0.5 then dir = flat.Unit end
            end
        end
        if not dir then dir = diveDirection() end
        diveLockedDir = dir

        local base = hrp.AssemblyLinearVelocity
        local horiz = Vector3.new(base.X, 0, base.Z)
        local speed
        if diveBoostEnabled and diveBoostSpeed > 0 then speed = diveBoostSpeed else speed = DIVE_RUSH_BASE_SPEED end

        local onHead = isOnHeadForRocketBoost()
        if onHead and rocketBoostEnabled and (math.random() * 100 <= rocketBoostChance) then
            speed = (ROCKET_BOOST_LEVEL - 1) * DIVE_LEVEL_STEP
        end
        hrp.AssemblyLinearVelocity = horiz + dir * speed + Vector3.new(0, base.Y, 0)
    end
    if not sideTechAnimPlaying then diveLockedDir = nil end
    prevDiveState = sideTechAnimPlaying

    if pullVectorEnabled and isHoldingM1 and not isFlying and not stickyTarget
       and not sideTechAnimPlaying then
        local ball = findFootball and findFootball()
        local bp = ballPos(ball)
        if bp then
            local direction = bp - hrp.Position
            local currentDistance = direction.Magnitude
            if currentDistance <= 4.5 then
                hrp.AssemblyLinearVelocity = V3_ZERO
            elseif currentDistance > 2 then
                hrp.AssemblyLinearVelocity = direction.Unit * pullSpeed
            end
        end
    end

    if autoRushUnlocked and autoRushActive and autoRushAllowed() and not isFlying and not stickyTarget then
        if sideTechAnimPlaying then
            if diveLockedDir then
                local vel = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(
                    diveLockedDir.X * walkSpeed, vel.Y, diveLockedDir.Z * walkSpeed
                )
            end
        else
            if humanoid.PlatformStand then humanoid.PlatformStand = false end
            if humanoid.Sit then humanoid.Sit = false end
            if humanoid:GetState() == Enum.HumanoidStateType.Physics then
                pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
            end
            if humanoid.AutoRotate then humanoid.AutoRotate = false end

            local targetPos = rushTargetPos()
            if targetPos then
                local diff = targetPos - hrp.Position
                local flat = Vector3.new(diff.X, 0, diff.Z)
                local flatMag = flat.Magnitude
                if flatMag > 0.05 then
                    local dir = flat / flatMag

                    local vel = hrp.AssemblyLinearVelocity
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        dir.X * walkSpeed,
                        vel.Y,
                        dir.Z * walkSpeed
                    )

                    local curCF = hrp.CFrame
                    local curYaw = yawFromCFrame(curCF)
                    local tgtYaw = math.atan2(-dir.X, -dir.Z)
                    local delta = angleDelta(curYaw, tgtYaw)

                    if math.abs(delta) < YAW_DEAD_ZONE then
                        delta = 0
                    else
                        local maxStep = TURN_RATE * dt
                        if delta > maxStep then delta = maxStep
                        elseif delta < -maxStep then delta = -maxStep end
                    end

                    if delta ~= 0 then
                        local newYaw = curYaw + delta
                        local newCF = CFrame.new(curCF.Position) * CFrame.Angles(0, newYaw, 0)
                        hrp.CFrame = newCF
                    end

                    hrp.AssemblyAngularVelocity = Vector3.zero

                    humanoid:Move(dir, false)
                end
            end
        end
    elseif autoRushActive and (isFlying or stickyTarget) then
        stopActiveRush()
    end

    if not autoRushActive and humanoid and not humanoid.AutoRotate and not stickyTarget and not sideTechAnimPlaying then
        humanoid.AutoRotate = true
    end

    if isFlying then
        if stickyTarget then detachSticky() end
        if humanoid.PlatformStand then humanoid.PlatformStand = false end
        if humanoid.Sit then humanoid.Sit = false end
        local s = humanoid:GetState()
        if s == Enum.HumanoidStateType.Physics then
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
        end
        local move = V3_ZERO
        if UIS:IsKeyDown(Enum.KeyCode.W) then move += camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += camera.CFrame.RightVector end
        local vertical = 0
        if UIS:IsKeyDown(Enum.KeyCode.Space) then vertical = vertical + 1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vertical = vertical - 1 end
        local targetVec = (move.Magnitude > 0) and move.Unit * flySpeed or V3_ZERO
        targetVec = Vector3.new(targetVec.X, vertical * flySpeed * 0.6, targetVec.Z)
        flyVelocity = flyVelocity:Lerp(targetVec, math.min(flyAccel * dt, 1))
        local hv = Vector3.new(flyVelocity.X, 0, flyVelocity.Z)
        if hv.Magnitude > FLY_MAX_VELOCITY then hv = hv.Unit * FLY_MAX_VELOCITY end
        local vv = math.clamp(flyVelocity.Y, -FLY_VERTICAL_CAP, FLY_VERTICAL_CAP)
        flyVelocity = Vector3.new(hv.X, vv, hv.Z)
        local vel = hrp.AssemblyLinearVelocity
        local newVX = vel.X + (flyVelocity.X - vel.X) * math.min(dt * 8, 1)
        local newVZ = vel.Z + (flyVelocity.Z - vel.Z) * math.min(dt * 8, 1)
        local newVY = vel.Y + (flyVelocity.Y - vel.Y) * math.min(dt * 8, 1)
        if vertical == 0 then newVY = newVY + gravityVal * dt * FLY_HOVER_LIFT end
        hrp.AssemblyLinearVelocity = Vector3.new(newVX, newVY, newVZ)
    else
        flyVelocity = V3_ZERO
    end

    local hasBall = holdingFootball()
    if hasBall and stickyTarget then detachSticky() end
    if stickyTarget and stickyTarget.Parent and targetHasFootball(stickyTarget.Parent) then detachSticky() end

    if stickyHeadEnabled and not isFlying and not hasBall and not sideTechAnimPlaying
       and not autoRushBlocksHeadTech() then
        if stickyReattachLocked then
            local overAny = findFeetOverHead(FEET_OVER_HEAD_HORIZ_MARGIN, FEET_OVER_HEAD_VERT_TOLERANCE)
            if overAny then
                stickyLockOffSince = nil
            else
                if not stickyLockOffSince then
                    stickyLockOffSince = now
                elseif (now - stickyLockOffSince) >= STICKY_LOCK_CLEAR_DELAY then
                    stickyReattachLocked = false
                    stickyLockOffSince = nil
                end
            end
        end

        if stickyTarget then
            local parentChar = stickyTarget.Parent
            local stillAlive = parentChar and parentChar.Parent == workspace
            local badState = targetInBadState(parentChar)
            local targetHoldsBall = parentChar and targetHasFootball(parentChar)
            local targetDiving = targetHeadDiving(stickyTarget)

            -- Geometric break: once the ease-in is done, if we're no longer
            -- above the head (knocked off, displaced, drifted), drop the
            -- stick. Stops the "magnet" look when we aren't on them.
            local lostContact = false
            if (now - attachTime) > EASE_DURATION then
                lostContact = not feetOverHead(stickyTarget, STICKY_BREAK_MARGIN, STICKY_BREAK_VERT)
            end

            if stickyReleaseInput or not stillAlive or badState or targetHoldsBall or targetDiving or lostContact then
                local reason = "other"
                if stickyReleaseInput then reason = "input" end
                if targetDiving then reason = "target_dive" end
                if lostContact then reason = "lost_contact" end
                detachSticky(reason)
            end
        end

        if not stickyTarget and stickyCooldown <= 0 and jumpBoostStickyCooldown <= 0
           and not anyMoveKeyDown() and not hasBall and not stickyReattachLocked
           and jumpedRecently then
            local head = findFeetOverHead(FEET_OVER_HEAD_HORIZ_MARGIN, FEET_OVER_HEAD_VERT_TOLERANCE)
            if head then attachSticky(head) end
        end

        if stickyTarget then
            local parentChar = stickyTarget.Parent
            local targetHrp = parentChar and parentChar:FindFirstChild("HumanoidRootPart")
            local targetMoving = false
            if targetHrp then
                local tVel = targetHrp.AssemblyLinearVelocity
                local flatVel = Vector3.new(tVel.X, 0, tVel.Z).Magnitude
                targetMoving = (flatVel >= IDLE_HRP_VELOCITY) or (math.abs(tVel.Y) >= IDLE_HRP_VELOCITY)
            end
            local headPos = stickyTarget.Position
            if targetMoving then
                if stickyLastTargetHeadPos then
                    local headDelta = headPos - stickyLastTargetHeadPos
                    if headDelta.Magnitude <= STICKY_FOLLOW_TELEPORT_THRESHOLD then
                        stickyAnchorPos += headDelta
                    end
                end
            end
            stickyLastTargetHeadPos = headPos

            local desiredPos = stickyAnchorPos or hrp.Position
            local newPos
            local elapsed = now - attachTime
            if elapsed < EASE_DURATION then
                local t = elapsed / EASE_DURATION
                local s = smoothstep(t)
                local startPos = stickyAttachStartPos or hrp.Position
                newPos = startPos:Lerp(desiredPos, s)
            else
                newPos = desiredPos
                stickyAttachStartPos = nil
            end

            local rot = stickyLockedRotation or (hrp.CFrame - hrp.CFrame.Position)
            hrp.CFrame = CFrame.new(newPos) * rot
            hrp.AssemblyLinearVelocity = V3_ZERO
            hrp.AssemblyAngularVelocity = V3_ZERO
            humanoid:Move(V3_ZERO, false)
            if humanoid.WalkSpeed ~= 0 then humanoid.WalkSpeed = 0 end
            if now >= stickyStateNextCheck then
                stickyStateNextCheck = now + STICKY_STATE_CHECK_INTERVAL
                pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
                humanoid:Move(V3_ZERO, false)
                local animator = humanoid:FindFirstChildOfClass("Animator")
                if animator then
                    for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
                        stopMovementPriority(tr)
                    end
                end
            end
        end
    elseif stickyTarget and (not stickyHeadEnabled or hasBall or isFlying or sideTechAnimPlaying
                            or autoRushBlocksHeadTech()) then
        detachSticky()
    end

    updateProxyCollision()
end))

