track(UIS.InputBegan:Connect(function(i, gp)
    if not alive then return end
    if gp then return end
    if i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode == AUTO_RUSH_KEY then
        toggleActiveRush()
        return
    end
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        isHoldingM1 = true
        if autoSideTechEnabled and not isShiftLocked() then
            local camLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
            sideTechTargetLookVector = Vector3.new(-camLook.Z, 0, camLook.X)
            isHoldingSideTech = true
        end
    end
    if stickyTarget then
        local key = i.KeyCode
        local isMoveKey = (key == Enum.KeyCode.W or key == Enum.KeyCode.A
                        or key == Enum.KeyCode.S or key == Enum.KeyCode.D)
        local isJumpKey = (key == Enum.KeyCode.Space)
        local isDiveInput = (i.UserInputType == Enum.UserInputType.MouseButton1)
        if isMoveKey or isJumpKey or isDiveInput then
            stickyReleaseInput = true
        end
    end
end))

