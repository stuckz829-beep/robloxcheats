            if c then add(c:FindFirstChild(FOOTBALL_NAME)) end
        end
    end
    add(workspace:FindFirstChild(FOOTBALL_NAME))
    if #list == 0 or (refreshCounter % FULL_SCAN_EVERY == 0) then
        local kids = workspace:GetChildren()
        for i = 1, #kids do
            local v = kids[i]
            if v.Name == FOOTBALL_NAME then add(v) end
        end
    end
    refreshCounter = refreshCounter + 1
    ballList = list
end

task.spawn(function()
    scanBallListOnce()
    while alive do
        task.wait(BALL_LIST_REFRESH)
        if not alive then break end
        scanBallListOnce()
    end
end)

findFootball = function()
    if not hrp then return ballList[1] end
    for i = #ballList, 1, -1 do
        local b = ballList[i]
        if not b or not b.Parent then table.remove(ballList, i) end
    end
    if #ballList == 0 then return nil end
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge
    for i = 1, #ballList do
        local c = ballList[i]
        local pos = ballPos(c)
        if pos then
            local d = (pos - myPos).Magnitude
            if d < bestDist then bestDist = d; best = c end
        end
    end
    return best or ballList[1]
end

-------------------------------------------------
-- AUTO RUSH
-------------------------------------------------
local function stopActiveRush()
    autoRushActive = false
    rushEngageStartAt = 0
    lastRushCarrier = nil
    if humanoid then
        pcall(function() humanoid:Move(V3_ZERO, false) end)
        if not humanoid.AutoRotate then humanoid.AutoRotate = true end
    end
end

local function disableAutoRush()
    autoRushUnlocked = false
    stopActiveRush()
end

local function toggleActiveRush()
    if not autoRushUnlocked then return end
    if not autoRushAllowed() then
        Rayfield:Notify({Title="Auto Rush", Content="WalkSpeed must be 21 or higher.", Duration=3})
        return
    end
    task.defer(function()
        if autoRushActive then
            stopActiveRush()
            Rayfield:Notify({Title="Auto Rush", Content="Off", Duration=2})
        else
            if stickyTarget then detachSticky() end
            for k in pairs(proxyEngaged) do proxyEngaged[k] = nil end
            autoRushActive = true
            rushEngageStartAt = 0
            lastRushCarrier = nil

            local carrier = getBallCarrier()
            if carrier then
                lastRushCarrier = carrier
                rushEngageStartAt = tick()
            end

            Rayfield:Notify({Title="Auto Rush", Content="On", Duration=2})
        end
    end)
end

local function rushTargetPos()
    local carrier = getBallCarrier()
    if not carrier then
        if lastRushCarrier ~= nil then
            lastRushCarrier = nil
            rushEngageStartAt = 0
        end
        local ball = findFootball and findFootball()
        return ballPos(ball)
    end

    if carrier ~= lastRushCarrier or rushEngageStartAt == 0 then
        lastRushCarrier = carrier
        rushEngageStartAt = tick()
    end

    local theirHrp = carrier:FindFirstChild("HumanoidRootPart")
    if not theirHrp then
        local ball = findFootball and findFootball()
        return ballPos(ball)
    end

    local theirPos = theirHrp.Position
    if not hrp then return theirPos + QB_CHEST_OFFSET end

    local chest = theirPos + QB_CHEST_OFFSET
    local myPos = hrp.Position

    local vel = theirHrp.AssemblyLinearVelocity
    local flatVel = Vector3.new(vel.X, 0, vel.Z)
    local speed = flatVel.Magnitude

    if speed < 1.0 then
        return chest
    end

    local hisDir = flatVel / speed

    local toHim = Vector3.new(theirPos.X - myPos.X, 0, theirPos.Z - myPos.Z)
    local dist = toHim.Magnitude
    if dist < 0.01 then
        return chest
    end

    local mySpeed = walkSpeed
    if mySpeed < 1 then mySpeed = 1 end

    local a = speed*speed - mySpeed*mySpeed
    local b = 2 * toHim:Dot(flatVel)
    local c = dist * dist

    local tIntercept = nil
    if math.abs(a) < 1e-4 then
        if math.abs(b) > 1e-4 then
            local t = -c / b
            if t > 0 then tIntercept = t end
        end
    else
        local disc = b*b - 4*a*c
        if disc >= 0 then
            local sq = math.sqrt(disc)
            local t1 = (-b + sq) / (2*a)
            local t2 = (-b - sq) / (2*a)
            if t1 > 0 and (not tIntercept or t1 < tIntercept) then tIntercept = t1 end
            if t2 > 0 and (not tIntercept or t2 < tIntercept) then tIntercept = t2 end
        end
    end

    if not tIntercept or tIntercept <= 0 then
        tIntercept = 0.6
    end
    tIntercept = math.clamp(tIntercept, RUSH_T_MIN, RUSH_T_MAX)

    local aim = chest + flatVel * (tIntercept * RUSH_OVERSHOOT)

    local forwardFromHim = (aim - theirPos):Dot(hisDir)
    if forwardFromHim < RUSH_FORWARD_MIN then
        aim = aim + hisDir * (RUSH_FORWARD_MIN - forwardFromHim)
    end

    local aimVec = aim - theirPos
    local aimLen = aimVec.Magnitude
    if aimLen > dist then
        aim = theirPos + aimVec.Unit * dist
    end

    return aim
end

-------------------------------------------------
-- HEAD SCALE / ORIGIN CAPTURE
-------------------------------------------------
local function readOrigFromAttr(part)
    local ok, v = pcall(function() return part:GetAttribute(ORIG_SIZE_ATTR) end)
    if not ok or not v then return nil end
    if typeof(v) ~= "Vector3" then return nil end
    return v
end

local function writeOrigToAttr(part, size)
    pcall(function() part:SetAttribute(ORIG_SIZE_ATTR, size) end)
end

local function captureOrig(part)
    if origSizes[part] then return origSizes[part] end
    local persisted = readOrigFromAttr(part)
    if persisted then
        origSizes[part] = persisted
        return persisted
    end
    local s = part.Size
    origSizes[part] = s
    writeOrigToAttr(part, s)
    return s
end

local function applyHeadNow(head)
    if not head or not head.Parent then return end
    local orig = captureOrig(head)
    local targetSize
    if isHeadModEnabled then
        targetSize = Vector3.new(targetHeadScale, orig.Y, targetHeadScale)
    else
        targetSize = orig
    end
    pcall(function()
        if (head.Size - targetSize).Magnitude > SIZE_EPS then head.Size = targetSize end
    end)
    if origCanCollide[head] == nil then
        origCanCollide[head] = head.CanCollide
    end
    if head.CanCollide then
        pcall(function() head.CanCollide = false end)
    end
end

local function applyToAllHeads()
    for i = 1, #cachedPlayers do
        local p = cachedPlayers[i]
        if p ~= localPlayer then
            local c = p.Character
            local h = c and c:FindFirstChild("Head")
            if h then headCache[p] = h; applyHeadNow(h) end
        end
    end
end

