-- Serializes color items out safely for JSON operations
local function formatConfigForSaving(configTable)
    local copy = HttpService:JSONDecode(HttpService:JSONEncode(configTable))
    -- Convert Color3 objects manually into serializable arrays
    copy.ESP.EnemyColor = {configTable.ESP.EnemyColor.R, configTable.ESP.EnemyColor.G, configTable.ESP.EnemyColor.B}
    copy.ESP.FriendColor = {configTable.ESP.FriendColor.R, configTable.ESP.FriendColor.G, configTable.ESP.FriendColor.B}
    copy.ESP.NameColor = {configTable.ESP.NameColor.R, configTable.ESP.NameColor.G, configTable.ESP.NameColor.B}
    copy.Aim.FOVColor = {configTable.Aim.FOVColor.R, configTable.Aim.FOVColor.G, configTable.Aim.FOVColor.B}
    return HttpService:JSONEncode(copy)
end

-- Re-imports data arrays back to physical active working states
local function parseLoadedConfigData(jsonString)
    local data = HttpService:JSONDecode(jsonString)
    data.ESP.EnemyColor = Color3.new(data.ESP.EnemyColor[1], data.ESP.EnemyColor[2], data.ESP.EnemyColor[3])
    data.ESP.FriendColor = Color3.new(data.ESP.FriendColor[1], data.ESP.FriendColor[2], data.ESP.FriendColor[3])
    data.ESP.NameColor = Color3.new(data.ESP.NameColor[1], data.ESP.NameColor[2], data.ESP.NameColor[3])
    data.Aim.FOVColor = Color3.new(data.Aim.FOVColor[1], data.Aim.FOVColor[2], data.Aim.FOVColor[3])
    return data
end

