-- TRACKER DATA LAYER
-- ============================================================
local ESPStore = {}

local function BuildESP(player)
    if player == LocalPlayer or ESPStore[player] then return end

    local hl = Instance.new("Highlight")
    hl.FillTransparency    = 1
    hl.OutlineTransparency = 0
    hl.OutlineColor        = CFG.ESP.EnemyColor
    hl.FillColor           = CFG.ESP.EnemyColor
    hl.Enabled             = false
    hl.Parent              = ScreenGui

    local bb = Instance.new("BillboardGui")
    bb.Size          = UDim2.new(0, 130, 0, 40)
    bb.StudsOffset   = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop   = true
    bb.Enabled       = false
    bb.Parent        = ScreenGui

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size                  = UDim2.new(1, 0, 0.55, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                  = player.Name
    nameLbl.TextColor3            = CFG.ESP.NameColor
    nameLbl.TextSize              = 12
    nameLbl.Font                  = Enum.Font.GothamBold
    nameLbl.TextStrokeTransparency = 0
    nameLbl.TextStrokeColor3      = Color3.new(0,0,0)
    nameLbl.Parent                = bb

    local distLbl = Instance.new("TextLabel")
    distLbl.Size                  = UDim2.new(1, 0, 0.45, 0)
    distLbl.Position              = UDim2.new(0, 0, 0.55, 0)
    distLbl.BackgroundTransparency = 1
    distLbl.Text                  = ""
    distLbl.TextColor3            = Color3.fromRGB(170, 215, 255)
    distLbl.TextSize              = 10
    distLbl.Font                  = Enum.Font.Gotham
    distLbl.TextStrokeTransparency = 0
    distLbl.TextStrokeColor3      = Color3.new(0,0,0)
    distLbl.Parent                = bb

    ESPStore[player] = {
        highlight = hl,
        billboard = bb,
        nameLbl   = nameLbl,
        distLbl   = distLbl,
    }
end

local function DestroyESP(player)
    local d = ESPStore[player]
    if d then
        d.highlight:Destroy()
        d.billboard:Destroy()
        ESPStore[player] = nil
    end
end

Players.PlayerAdded:Connect(BuildESP)
Players.PlayerRemoving:Connect(DestroyESP)
for _, p in ipairs(Players:GetPlayers()) do BuildESP(p) end

-- ============================================================
-- MAIN LOOP
-- ============================================================
RunService.Heartbeat:Connect(function()
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if localChar then
        local hum = localChar:FindFirstChildOfClass("Humanoid")
        if hum then
            if CFG.Move.SpeedEnabled then hum.WalkSpeed = CFG.Move.SpeedVal end
            if CFG.Move.JumpEnabled  then hum.JumpPower  = CFG.Move.JumpVal  end
        end
    end

    lineUsed = 0
    local vpSize = Camera.ViewportSize
    local tracerOrigin = Vector2.new(vpSize.X * 0.5, vpSize.Y)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local d = ESPStore[player]
        if not d then BuildESP(player) continue end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local alive = hum and hum.Health > 0

        if not (CFG.ESP.Enabled and char and root and alive) then
            d.highlight.Enabled = false
            d.billboard.Enabled = false
            continue
        end

        local dist = localRoot and (root.Position - localRoot.Position).Magnitude or 0
        if dist > CFG.ESP.MaxDist then
            d.highlight.Enabled = false
            d.billboard.Enabled = false
            continue
        end

        local isEnemy = true
        if CFG.ESP.TeamCheck and player.Team and LocalPlayer.Team then
            isEnemy = player.Team ~= LocalPlayer.Team
        end
        local col = isEnemy and CFG.ESP.EnemyColor or CFG.ESP.FriendColor

        -- Highlights Setup
        d.highlight.Adornee      = char
        d.highlight.OutlineColor = col
        d.highlight.FillColor    = col
        d.highlight.OutlineTransparency = CFG.ESP.Boxes and 0 or 1
        d.highlight.FillTransparency    = CFG.ESP.Chams and 0.5 or 1
        d.highlight.Enabled = CFG.ESP.Boxes or CFG.ESP.Chams

        -- Billboard Setup
        local showBB = CFG.ESP.Names or CFG.ESP.Distance
        d.billboard.Adornee = root
        d.billboard.Enabled = showBB
        if showBB then
            d.nameLbl.Visible = CFG.ESP.Names
            d.nameLbl.Text    = player.Name
            d.distLbl.Visible = CFG.ESP.Distance
            d.distLbl.Text    = CFG.ESP.Distance and (math.floor(dist).." studs") or ""
        end

        -- Tracers Rendering
        if CFG.ESP.Tracers then
            local rootSP, onSc = WorldToScreen(root.Position)
            if onSc then
                DrawLine(tracerOrigin, rootSP, col, 1)
            end
        end

        -- Skeleton Rendering
        if CFG.ESP.Skeleton then
            for _, pair in ipairs(SKELETON_PAIRS) do
                local partA = char:FindFirstChild(pair[1])
                local partB = char:FindFirstChild(pair[2])
                if partA and partB then
                    local spA, onA = WorldToScreen(partA.Position)
                    local spB, onB = WorldToScreen(partB.Position)
                    if onA and onB then
                        DrawLine(spA, spB, col, 1)
                    end
                end
            end
        end
    end

    HideExtraLines()
end)

