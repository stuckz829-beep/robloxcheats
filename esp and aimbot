local function fetchSavedConfigsList()
    local list = {}
    if not listfiles then return {"Default"} end
    pcall(function()
        for _, path in ipairs(listfiles("Phantom_Configs")) do
            local name = path:match("([^\\/]+)%.json$")
            if name then table.insert(list, name) end
        end
    end)
    if #list == 0 then table.insert(list, "No Configs Found") end
    return list
end

