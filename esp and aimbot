local ESPStore = {}

local function BuildESP(player)
    if player == LocalPlayer or ESPStore[player] then return end

    local hl = Instance.new("Highlight", ScreenGui)
    hl.FillTransparency = 1
    hl.OutlineTransparency = 0
    hl.Enabled = false

    local bb = Instance.new("BillboardGui", ScreenGui)
    bb.Size = UDim2.new(0, 150, 0, 45)
    bb.AlwaysOnTop = true
    bb.Enabled = false

    local nameLbl = Instance.new("TextLabel", bb)
    nameLbl.Size = UDim2.new(1, 0, 0.5, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.TextColor3 = CFG.ESP.NameColor
    nameLbl.TextSize = 12
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextStrokeTransparency = 0

    local distLbl = Instance.new("TextLabel", bb)
    distLbl.Size = UDim2.new(1, 0, 0.5, 0)
    distLbl.Position = UDim2.new(0, 0, 0.5, 0)
    distLbl.BackgroundTransparency = 1
    distLbl.TextColor3 = Color3.fromRGB(200, 220, 255)
    distLbl.TextSize = 10
    distLbl.Font = Enum.Font.Gotham
    distLbl.TextStrokeTransparency = 0

    ESPStore[player] = { highlight = hl, billboard = bb, nameLbl = nameLbl, distLbl = distLbl }
end

local function DestroyESP(player)
    local d = ESPStore[player]
    if d then
        pcall(function() d.highlight:Destroy() end)
        pcall(function() d.billboard:Destroy() end)
        ESPStore[player] = nil
    end
end

Players.PlayerAdded:Connect(BuildESP)
Players.PlayerRemoving:Connect(DestroyESP)
for _, p in ipairs(Players:GetPlayers()) do BuildESP(p) end

