                end
            end)
        end
    elseif localChar and flyActive and flyBodyVel and flyBodyGyro then
        local root = GetRoot(localChar)
        if root then
            local speed = CFG.Move.FlySpeed
            local dir   = Vector3.zero

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end

            flyBodyVel.Velocity = dir.Magnitude > 0 and dir.Unit * speed or Vector3.zero
            flyBodyGyro.CFrame = Camera.CFrame
        end
    end

    lineUsed = 0
    local vpSize = Camera.ViewportSize
    local tracerOrigin = Vector2.new(vpSize.X * 0.5, vpSize.Y)

    -- Track FOV Interactive Drawing Frame
    if CFG.Aim.ShowFOV and CFG.Aim.Enabled then
        local mPos = UserInputService:GetMouseLocation()
        FOVCircle.Position = UDim2.fromOffset(mPos.X, mPos.Y)
        FOVCircle.Size = UDim2.fromOffset(CFG.Aim.FOV * 2, CFG.Aim.FOV * 2)
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end

    -- Smooth Camera Synchronization Aimbot
    if CFG.Aim.Enabled then
        local currentTargetRoot = GetClosestPlayerToMouse()
        if currentTargetRoot then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, currentTargetRoot.Position), CFG.Aim.Smoothing)
        end
    end

    -- Process World Tracked Entities Safely
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local d = ESPStore[player]
        if not d then BuildESP(player) continue end

        local char = player.Character
        local root = GetRoot(char)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local alive = hum and hum.Health > 0

        -- Break out completely if feature disabled or object streamed out out of scope
        if not (CFG.ESP.Enabled and char and root and alive) then
            d.highlight.Enabled = false
            d.billboard.Enabled = false
            continue
        end

        local dist = localRoot and (root.Position - localRoot.Position).Magnitude or 0
        if dist > CFG.ESP.MaxDist then
            d.highlight.Enabled = false
            d.billboard.Enabled = false
            continue
        end

        local isEnemy = true
        if CFG.ESP.TeamCheck and player.Team and LocalPlayer.Team then
            isEnemy = player.Team ~= LocalPlayer.Team
        end
        local col = isEnemy and CFG.ESP.EnemyColor or CFG.ESP.FriendColor

        -- Setup Dynamic Outlines (Highlights)
        d.highlight.Adornee      = char
        d.highlight.OutlineColor = col
        d.highlight.FillColor    = col
        d.highlight.OutlineTransparency = CFG.ESP.Boxes and 0 or 1
        d.highlight.FillTransparency    = CFG.ESP.Chams and 0.5 or 1
        d.highlight.Enabled = CFG.ESP.Boxes or CFG.ESP.Chams

        -- Setup Hovering Labels
        local showBB = CFG.ESP.Names or CFG.ESP.Distance
        d.billboard.Adornee = root
        d.billboard.StudsOffset = Vector3.new(0, (char:GetScale() * 3.5), 0) -- Scaled to work on big/small avatars
        d.billboard.Enabled = showBB
        if showBB then
            d.nameLbl.Visible = CFG.ESP.Names
            d.nameLbl.Text    = player.Name
            d.distLbl.Visible = CFG.ESP.Distance
            d.distLbl.Text    = CFG.ESP.Distance and (math.floor(dist).." studs") or ""
        end

        -- Render Line Snap Tracers
        if CFG.ESP.Tracers then
            local rootSP, onSc = WorldToScreen(root.Position)
            if onSc then DrawLine(tracerOrigin, rootSP, col, 1) end
        end

        -- Render Dynamic Adaptive Skeletal Pairs
        if CFG.ESP.Skeleton then
            local skeletonStructure = char:FindFirstChild("UpperTorso") and R15_SKELETON or R6_SKELETON
            for _, pair in ipairs(skeletonStructure) do
                local partA = char:FindFirstChild(pair[1])
                local partB = char:FindFirstChild(pair[2])
                if partA and partB then
                    local spA, onA = WorldToScreen(partA.Position)
                    local spB, onB = WorldToScreen(partB.Position)
                    if onA and onB then DrawLine(spA, spB, col, 1) end
                end
            end
        end
    end

    HideExtraLines()
end)

