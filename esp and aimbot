local ESPStore = {}

local function BuildESP(player)
    if player == LocalPlayer or ESPStore[player] then return end

    local hl = Instance.new("Highlight")
    hl.FillTransparency    = 1
    hl.OutlineTransparency = 0
    hl.Enabled              = false
    hl.Parent              = ScreenGui

    local bb = Instance.new("BillboardGui")
    bb.Size          = UDim2.new(0, 130, 0, 40)
    bb.StudsOffset   = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop   = true
    bb.Enabled       = false
    bb.Parent        = ScreenGui

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size                  = UDim2.new(1, 0, 0.55, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                  = player.Name
    nameLbl.TextColor3            = CFG.ESP.NameColor
    nameLbl.TextSize              = 12
    nameLbl.Font                  = Enum.Font.GothamBold
    nameLbl.TextStrokeTransparency = 0
    nameLbl.Parent                = bb

    local distLbl = Instance.new("TextLabel")
    distLbl.Size                  = UDim2.new(1, 0, 0.45, 0)
    distLbl.Position              = UDim2.new(0, 0, 0.55, 0)
    distLbl.BackgroundTransparency = 1
    distLbl.TextColor3            = Color3.fromRGB(170, 215, 255)
    distLbl.TextSize              = 10
    distLbl.Font                  = Enum.Font.Gotham
    distLbl.TextStrokeTransparency = 0
    distLbl.Parent                = bb

    ESPStore[player] = { highlight = hl, billboard = bb, nameLbl = nameLbl, distLbl = distLbl }
end

local function DestroyESP(player)
    local d = ESPStore[player]
    if d then
        d.highlight:Destroy()
        d.billboard:Destroy()
        ESPStore[player] = nil
    end
end

Players.PlayerAdded:Connect(BuildESP)
Players.PlayerRemoving:Connect(DestroyESP)
for _, p in ipairs(Players:GetPlayers()) do BuildESP(p) end

