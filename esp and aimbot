local flyActive = false
local flyBodyVel, flyBodyGyro

local function startFly()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 5)
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not (root and hum) then return end

    hum.PlatformStand = true
    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(9e8, 9e8, 9e8)
    flyBodyGyro.P = 9e4
    flyBodyGyro.CFrame = root.CFrame
    flyBodyGyro.Parent = root

    flyBodyVel = Instance.new("BodyVelocity")
    flyBodyVel.Velocity = Vector3.zero
    flyBodyVel.MaxForce = Vector3.new(9e8, 9e8, 9e8)
    flyBodyVel.Parent = root
end

local function stopFly()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    if flyBodyVel  then flyBodyVel:Destroy()  flyBodyVel  = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
end

UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.F and CFG.Move.FlyEnabled then
        flyActive = not flyActive
        if flyActive then startFly() else stopFly() end
    end
end)

RunService.Heartbeat:Connect(function()
    if not flyActive or not flyBodyVel or not flyBodyGyro then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local cam   = Camera
    local speed = CFG.Move.FlySpeed
    local dir   = Vector3.zero

    if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end

    flyBodyVel.Velocity = dir.Magnitude > 0 and dir.Unit * speed or Vector3.zero
    flyBodyGyro.CFrame = cam.CFrame
end)

local function WorldToScreen(pos)
    local screenPos, onScreen = Camera:WorldToScreenPoint(pos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

local linePool = {}
local lineUsed = 0

local function GetLine()
    lineUsed += 1
    if not linePool[lineUsed] then
        local f = Instance.new("Frame")
        f.AnchorPoint = Vector2.new(0.5, 0)
        f.BorderSizePixel = 0
        f.BackgroundColor3 = Color3.new(1,1,1)
        f.ZIndex = 2
        f.Parent = DrawFrame
        linePool[lineUsed] = f
    end
    linePool[lineUsed].Visible = true
    return linePool[lineUsed]
end

local function HideExtraLines()
    for i = lineUsed + 1, #linePool do
        linePool[i].Visible = false
    end
end

local function DrawLine(p1: Vector2, p2: Vector2, color: Color3, thickness: number)
    local line = GetLine()
    local diff = p2 - p1
    local len  = diff.Magnitude
    local ang  = math.atan2(diff.Y, diff.X)
    line.Position = UDim2.fromOffset(p1.X, p1.Y)
    line.Size = UDim2.fromOffset(len, thickness or 1)
    line.Rotation = math.deg(ang)
    line.BackgroundColor3 = color
    line.BackgroundTransparency = 0
end

local function GetClosestPlayerToMouse()
    local target = nil
    local maxDistance = CFG.Aim.FOV
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if CFG.ESP.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if root and hum and hum.Health > 0 then
            local localChar = LocalPlayer.Character
            local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
            local distFromMe = localRoot and (root.Position - localRoot.Position).Magnitude or 0
            
            if distFromMe <= CFG.ESP.MaxDist then
                local screenPos, onScreen = WorldToScreen(root.Position)
                if onScreen then
                    local distanceToMouse = (screenPos - mousePos).Magnitude
                    if distanceToMouse < maxDistance then
                        maxDistance = distanceToMouse
                        target = root
                    end
                end
            end
        end
    end
    return target
end

