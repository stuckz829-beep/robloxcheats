local flyActive = false
local flyBodyVel, flyBodyGyro

local function startFly()
    local char = LocalPlayer.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not (root and hum) then return end

    hum.PlatformStand = true
    flyBodyGyro = Instance.new("BodyGyro", root)
    flyBodyGyro.MaxTorque = Vector3.new(9e8, 9e8, 9e8)
    flyBodyGyro.P = 9e4
    flyBodyGyro.CFrame = root.CFrame

    flyBodyVel = Instance.new("BodyVelocity", root)
    flyBodyVel.Velocity = Vector3.zero
    flyBodyVel.MaxForce = Vector3.new(9e8, 9e8, 9e8)
end

local function stopFly()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
    if flyBodyVel  then flyBodyVel:Destroy()  flyBodyVel  = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
end

UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.F and CFG.Move.FlyEnabled then
        flyActive = not flyActive
        if flyActive then startFly() else stopFly() end
    end
end)

local function WorldToScreen(pos)
    local screenPos, onScreen = Camera:WorldToScreenPoint(pos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

local function GetRoot(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
end

local function GetClosestPlayerToMouse()
    local target = nil
    local maxDistance = CFG.Aim.FOV
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if CFG.ESP.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end

        local char = player.Character
        local root = GetRoot(char)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if root and hum and hum.Health > 0 then
            local localRoot = GetRoot(LocalPlayer.Character)
            local distFromMe = localRoot and (root.Position - localRoot.Position).Magnitude or 0
            
            if distFromMe <= CFG.ESP.MaxDist then
                local screenPos, onScreen = WorldToScreen(root.Position)
                if onScreen then
                    local distanceToMouse = (screenPos - mousePos).Magnitude
                    if distanceToMouse < maxDistance then
                        maxDistance = distanceToMouse
                        target = root
                    end
                end
            end
        end
    end
    return target
end

local linePool, lineUsed = {}, 0
local function GetLine()
    lineUsed = lineUsed + 1
    if not linePool[lineUsed] then
        local f = Instance.new("Frame", DrawFrame)
        f.AnchorPoint = Vector2.new(0.5, 0)
        f.BorderSizePixel = 0
        f.BackgroundColor3 = Color3.new(1,1,1)
        f.ZIndex = 2
        linePool[lineUsed] = f
    end
    linePool[lineUsed].Visible = true
    return linePool[lineUsed]
end

local function HideExtraLines()
    for i = lineUsed + 1, #linePool do linePool[i].Visible = false end
end

local function DrawLine(p1, p2, color, thickness)
    local line = GetLine()
    local diff = p2 - p1
    line.Position = UDim2.fromOffset(p1.X, p1.Y)
    line.Size = UDim2.fromOffset(diff.Magnitude, thickness or 1)
    line.Rotation = math.deg(math.atan2(diff.Y, diff.X))
    line.BackgroundColor3 = color
    line.BackgroundTransparency = 0
end

