local function stopActiveRush()
    autoRushActive = false
    rushEngageStartAt = 0
    lastRushCarrier = nil
    if humanoid then
        pcall(function() humanoid:Move(V3_ZERO, false) end)
        if not humanoid.AutoRotate then humanoid.AutoRotate = true end
    end
