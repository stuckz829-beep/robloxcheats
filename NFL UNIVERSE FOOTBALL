local function bindCarrierTracking(char)
    if not char then return end
    char.ChildAdded:Connect(function(child)
        if child.Name == FOOTBALL_NAME and char ~= localPlayer.Character then
            ballCarrierChar = char
        end
    end)
    char.ChildRemoved:Connect(function(child)
        if child.Name == FOOTBALL_NAME and ballCarrierChar == char then
            ballCarrierChar = nil
        end
    end)
    if char:FindFirstChild(FOOTBALL_NAME) and char ~= localPlayer.Character then
        ballCarrierChar = char
    end
end

