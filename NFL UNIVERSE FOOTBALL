local function teardown()
    alive = false
    clearThrowWatch()
    destroyAllHeadProxies()
    detachStickyTargetJumpConn()
    for inst, t in pairs(origTransparency) do
        pcall(function() if inst and inst.Parent then inst.Transparency = t end end)
    end
    for head, cc in pairs(origCanCollide) do
        pcall(function() if head and head.Parent then head.CanCollide = cc end end)
    end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
    pcall(function() Rayfield:Destroy() end)
end

getgenv()[DESTROY_KEY] = teardown
local registry = getgenv()[TEARDOWN_REGISTRY]
if type(registry) == "table" then
    registry[#registry+1] = teardown
else
    getgenv()[TEARDOWN_REGISTRY] = {teardown}
end

