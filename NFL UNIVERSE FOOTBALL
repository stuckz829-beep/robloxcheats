-- HEAD SCALE
-------------------------------------------------
local function captureOrig(head)
    if origSizes[head] then return origSizes[head] end
    local s = head.Size
    origSizes[head] = s
    return s
end

local function applyHeadNow(head)
    if not head or not head.Parent then return end
    local orig = captureOrig(head)
    local targetSize
    if isHeadModEnabled then
        targetSize = Vector3.new(targetHeadScale, orig.Y, targetHeadScale)
    else
        targetSize = orig
    end
    pcall(function()
        if (head.Size - targetSize).Magnitude > SIZE_EPS then
            head.Size = targetSize
        end
    end)
end

local function applyToAllHeads()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local c = p.Character
        local h = c and c:FindFirstChild("Head")
        if h then
            headCache[p] = h
            applyHeadNow(h)
        end
    end
end

