-------------------------------------------------
local function isSideTechTrack(tr)
    if not tr then return false end
    local ok, anim = pcall(function() return tr.Animation end)
    if not ok or not anim then return false end
    local ok2, id = pcall(function() return anim.AnimationId end)
    if not ok2 or not id then return false end
    return id == SIDE_TECH_ANIM_ID
end

local function stopMovementPriority(tr)
    if not tr then return end
    if isSideTechTrack(tr) then return end
    local ok, prio = pcall(function() return tr.Priority end)
    if ok and prio == Enum.AnimationPriority.Movement then
        pcall(function() tr:Stop(0) end)
    end
end

local function forceStandingState()
    if not humanoid then return end
    if humanoid.PlatformStand then humanoid.PlatformStand = false end
    if humanoid.Sit then humanoid.Sit = false end
    local st = humanoid:GetState()
    if st == Enum.HumanoidStateType.Physics
    or st == Enum.HumanoidStateType.Ragdoll
    or st == Enum.HumanoidStateType.FallingDown
    or st == Enum.HumanoidStateType.Freefall
    or st == Enum.HumanoidStateType.Jumping then
        pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
    end
end

local function silenceHumanoid()
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
            stopMovementPriority(tr)
        end
        if stickyAnimConn then pcall(function() stickyAnimConn:Disconnect() end) end
        stickyAnimConn = animator.AnimationPlayed:Connect(function(tr)
            if not alive then return end
            stopMovementPriority(tr)
        end)
    end
    for _, s in ipairs({
        Enum.HumanoidStateType.Freefall,
        Enum.HumanoidStateType.Jumping,
        Enum.HumanoidStateType.FallingDown,
        Enum.HumanoidStateType.Ragdoll,
    }) do
        if humanoid:GetStateEnabled(s) then
            humanoid:SetStateEnabled(s, false)
            disabledStates[s] = true
        end
    end
    if savedWalkSpeed == nil then savedWalkSpeed = humanoid.WalkSpeed end
    if savedJumpPower == nil then savedJumpPower = humanoid.JumpPower end
    if savedJumpHeight == nil then savedJumpHeight = humanoid.JumpHeight end
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.JumpHeight = 0
    humanoid:Move(V3_ZERO, false)
    forceStandingState()
end

local function unsilenceHumanoid()
    if not humanoid then return end
    if stickyAnimConn then pcall(function() stickyAnimConn:Disconnect() end); stickyAnimConn = nil end
    for s, _ in pairs(disabledStates) do humanoid:SetStateEnabled(s, true) end
    disabledStates = {}
    if savedWalkSpeed ~= nil then humanoid.WalkSpeed = savedWalkSpeed; savedWalkSpeed = nil end
    if savedJumpPower ~= nil then humanoid.JumpPower = savedJumpPower; savedJumpPower = nil end
    if savedJumpHeight ~= nil then humanoid.JumpHeight = savedJumpHeight; savedJumpHeight = nil end
end

local function detachTargetAnimListener()
    if targetAnimConn then pcall(function() targetAnimConn:Disconnect() end); targetAnimConn = nil end
end

local function watchTargetForDive(target)
    detachTargetAnimListener()
    if not target or not target.Character then return end
    local animator = target.Character:FindFirstChildOfClass("Animator")
    if not animator then return end
    targetAnimConn = animator.AnimationPlayed:Connect(function(tr)
        if not alive then return end
        if tr.Animation and tr.Animation.AnimationId == SIDE_TECH_ANIM_ID then
            stickyReleaseInput = true
        end
    end)
end

detachSticky = function()
    local prevHead = stickyTarget
    stickyTarget = nil
    stickyReleaseInput = false
    stickyCooldown = REATTACH_COOLDOWN
    attachTime = 0
    stickyLockedRotation = nil
    detachTargetAnimListener()
    unsilenceHumanoid()
    walkSpeedLockSuspended = false
    if prevHead and prevHead.Parent then prevHead.CanCollide = true end
    enforceWalkSpeed()
end

local function attachSticky(head)
    stickyTarget = head
    stickyReleaseInput = false
    attachTime = tick()
    walkSpeedLockSuspended = true
    if hrp then
        hrp.AssemblyLinearVelocity = V3_ZERO
        hrp.AssemblyAngularVelocity = V3_ZERO
        local look = hrp.CFrame.LookVector
        local yaw = math.atan2(-look.X, -look.Z)
        stickyLockedRotation = CFrame.Angles(0, yaw, 0)
    end
    silenceHumanoid()
    forceStandingState()
    if head and head.Parent then
        local char = head.Parent
        local player = Players:GetPlayerFromCharacter(char)
        if player then watchTargetForDive(player) end
    end
end

local function hookChar(char)
    humanoid = char:WaitForChild("Humanoid")
    hrp = char:WaitForChild("HumanoidRootPart")

    walkSpeedLockSuspended = false
    enforceWalkSpeed()
    installWalkSpeedLock(humanoid)

    local animator = humanoid:WaitForChild("Animator")
    track(animator.AnimationPlayed:Connect(function(tr)
        if not alive then return end
        if tr.Animation and tr.Animation.AnimationId == SIDE_TECH_ANIM_ID then
            sideTechAnimPlaying = true
            if stickyTarget then detachSticky() end
            tr.Stopped:Once(function()
                sideTechAnimPlaying = false
                diveLockedDir = nil
            end)
        end
    end))

    track(humanoid.Jumping:Connect(function()
        if not alive then return end
        lastJumpTime = tick()
        lastJumpRequestAt = tick()
        if stickyTarget then stickyReleaseInput = true end
    end))

    track(humanoid.Died:Connect(function()
        if not alive then return end
        stickyTarget = nil
        stickyReleaseInput = false
        walkSpeedLockSuspended = false
        diveLockedDir = nil
        lastJumpRequestAt = 0
        lastHeadContactAt = 0
        if stickyAnimConn then pcall(function() stickyAnimConn:Disconnect() end); stickyAnimConn = nil end
        if humanoid then
            for s, _ in pairs(disabledStates) do humanoid:SetStateEnabled(s, true) end
            disabledStates = {}
            if savedWalkSpeed then humanoid.WalkSpeed = savedWalkSpeed end
            if savedJumpPower then humanoid.JumpPower = savedJumpPower end
            if savedJumpHeight then humanoid.JumpHeight = savedJumpHeight end
        end
    end))
end

