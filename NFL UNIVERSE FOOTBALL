local function applyJumpBoost(fromHead)
    if not jumpBoostEnabled or stickyTarget then return end
    if not hrp or not humanoid or jumpBoostStuds <= 0 then return end
    if isFlying or sideTechAnimPlaying or holdingFootball() then return end
    if math.random() * 100 > jumpBoostChance then return end
    jumpBoostStickyCooldown = JUMP_BOOST_STICKY_COOLDOWN
    local boostV = studsToVelocity(jumpBoostStuds)
    local vel = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = Vector3.new(vel.X, boostV, vel.Z)
    jumpBoostHoldUntil = 0
    jumpBoostHoldVelocity = 0
    pcall(function()
        local st = humanoid:GetState()
        if st == Enum.HumanoidStateType.Landed
        or st == Enum.HumanoidStateType.Running
        or st == Enum.HumanoidStateType.RunningNoPhysics then
            humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        end
    end)
    lastJumpTime = tick()
end

local function isActivelyOnHeadOf(player)
    if not player or holdingFootball() then return false end
    local theirChar = player.Character
    if not theirChar then return false end
    local theirHead = theirChar:FindFirstChild("Head")
    if not theirHead then return false end
    if stickyTarget == theirHead then return true end
    if proxyEngaged[theirHead] == true then return true end
    return false
end

local function watchPlayerJumps(player)
    if targetJumpConns[player] then return end
    local rec = {}
    local function bindHumanoid(hum)
        if not hum then return end
        if rec.humConn then pcall(function() rec.humConn:Disconnect() end) end
        rec.humConn = hum.Jumping:Connect(function()
            if not alive or player == localPlayer then return end
            if jumpBoostEnabled and not sideTechAnimPlaying then
                if not stickyTarget and isActivelyOnHeadOf(player) then
                    local head = headCache[player]
                    if head and head.Parent then applyJumpBoost(head) end
                end
            end
        end)
    end
    if player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then bindHumanoid(hum) end
    end
    rec.charConn = player.CharacterAdded:Connect(function(char)
        if not alive then return end
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then bindHumanoid(hum) end
    end)
    targetJumpConns[player] = rec
end
local function unwatchPlayerJumps(player)
    local rec = targetJumpConns[player]
    if rec then
        if rec.humConn then pcall(function() rec.humConn:Disconnect() end) end
        if rec.charConn then pcall(function() rec.charConn:Disconnect() end) end
        targetJumpConns[player] = nil
    end
end

