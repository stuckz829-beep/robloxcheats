local function buildFallbackUI()
    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local CoreGui = game:GetService("CoreGui")
    local lp = Players.LocalPlayer

    local function parentGui()
        if type(gethui) == "function" then
            local ok, h = pcall(gethui)
            if ok and h then return h end
        end
        return lp:FindFirstChild("PlayerGui") or CoreGui
    end

    local T = {
        bg = Color3.fromRGB(20,20,24),
        panel = Color3.fromRGB(28,28,34),
        panel2 = Color3.fromRGB(36,36,44),
        text = Color3.fromRGB(230,230,235),
        sub = Color3.fromRGB(150,150,160),
        accent = Color3.fromRGB(90,140,220),
        accent2 = Color3.fromRGB(60,100,180),
        border = Color3.fromRGB(48,48,56),
        on = Color3.fromRGB(90,200,120),
        off = Color3.fromRGB(80,80,90),
    }

    local API = {notifications = {}}
    local activeWindow = nil

    local function mk(cls, props, parent)
        local i = Instance.new(cls)
        for k,v in pairs(props or {}) do i[k] = v end
        if parent then i.Parent = parent end
        return i
    end
    local function corner(p, r) mk("UICorner", {CornerRadius = UDim.new(0, r or 6)}, p) end

    local function draggable(frame, handle)
        handle = handle or frame
        local drag, start, sp
        handle.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
                drag = true; start = inp.Position; sp = frame.Position
            end
        end)
        handle.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
                drag = false
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if not drag then return end
            if inp.UserInputType ~= Enum.UserInputType.MouseMovement
            and inp.UserInputType ~= Enum.UserInputType.Touch then return end
            local d = inp.Position - start
            frame.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
        end)
    end

    local TabMethods = {}

    function TabMethods:CreateSection(text)
        local h = mk("Frame", {Size = UDim2.new(1,0,0,22), BackgroundTransparency = 1, Parent = self.__page})
        mk("TextLabel", {
            Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1,
            Text = text, TextColor3 = T.sub, Font = Enum.Font.GothamBold,
            TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = h,
        })
        return h
    end

    function TabMethods:CreateButton(opts)
        local b = mk("TextButton", {
            Size = UDim2.new(1,0,0,28), BackgroundColor3 = T.panel2, BorderSizePixel = 0,
            Text = opts.Name or "Button", TextColor3 = T.text, Font = Enum.Font.Gotham,
            TextSize = 13, AutoButtonColor = false, Parent = self.__page,
        })
        corner(b, 5)
        b.MouseButton1Click:Connect(function() if opts.Callback then pcall(opts.Callback) end end)
        return {Set = function() end}
    end

    function TabMethods:CreateToggle(opts)
        local row = mk("Frame", {
            Size = UDim2.new(1,0,0,26), BackgroundColor3 = T.panel2,
            BorderSizePixel = 0, Parent = self.__page,
        })
        corner(row, 5)
        mk("TextLabel", {
            Size = UDim2.new(1,-56,1,0), Position = UDim2.new(0,8,0,0),
            BackgroundTransparency = 1, Text = opts.Name or "Toggle",
            TextColor3 = T.text, Font = Enum.Font.Gotham, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = row,
        })
        local knob = mk("Frame", {
            Size = UDim2.new(0,36,0,16), Position = UDim2.new(1,-44,0.5,-8),
            BackgroundColor3 = T.off, BorderSizePixel = 0, Parent = row,
        })
        corner(knob, 8)
        local dot = mk("Frame", {
            Size = UDim2.new(0,12,0,12), Position = UDim2.new(0,2,0.5,-6),
            BackgroundColor3 = Color3.fromRGB(240,240,240), BorderSizePixel = 0, Parent = knob,
        })
        corner(dot, 6)
        local state = opts.CurrentValue == true
        local function render()
            knob.BackgroundColor3 = state and T.on or T.off
            dot.Position = state and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)
        end
        render()
        local btn = mk("TextButton", {Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Text = "", Parent = row})
        btn.MouseButton1Click:Connect(function()
            state = not state
            render()
            if opts.Callback then pcall(opts.Callback, state) end
        end)
        local api = {}
        function api:Set(v) state = v == true; render() end
        return api
    end

    function TabMethods:CreateSlider(opts)
        local row = mk("Frame", {
            Size = UDim2.new(1,0,0,38), BackgroundColor3 = T.panel2,
            BorderSizePixel = 0, Parent = self.__page,
        })
        corner(row, 5)
        mk("TextLabel", {
            Size = UDim2.new(1,-80,0,18), Position = UDim2.new(0,8,0,2),
            BackgroundTransparency = 1, Text = opts.Name or "Slider",
            TextColor3 = T.text, Font = Enum.Font.Gotham, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
        })
        local valLbl = mk("TextLabel", {
            Size = UDim2.new(0,60,0,18), Position = UDim2.new(1,-68,0,2),
            BackgroundTransparency = 1, Text = tostring(opts.CurrentValue or 0),
            TextColor3 = T.sub, Font = Enum.Font.Gotham, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right, Parent = row,
        })
        local bar = mk("Frame", {
            Size = UDim2.new(1,-20,0,6), Position = UDim2.new(0,10,1,-14),
            BackgroundColor3 = T.off, BorderSizePixel = 0, Parent = row,
        })
        corner(bar, 3)
        local fill = mk("Frame", {
            Size = UDim2.new(0,0,1,0), BackgroundColor3 = T.accent,
            BorderSizePixel = 0, Parent = bar,
        })
        corner(fill, 3)
        local minV = opts.Range and opts.Range[1] or 0
        local maxV = opts.Range and opts.Range[2] or 100
        local inc = opts.Increment or 1
        local value = opts.CurrentValue or minV
        local function clampInc(v)
            local steps = math.floor((v - minV)/inc + 0.5)
            return math.clamp(minV + steps*inc, minV, maxV)
        end
        local function render()
            fill.Size = UDim2.new((value-minV)/math.max(1e-6,(maxV-minV)),0,1,0)
            valLbl.Text = tostring(value)
        end
        render()
        local dragging = false
        local function upd(x)
            local rel = math.clamp((x - bar.AbsolutePosition.X)/math.max(1,bar.AbsoluteSize.X),0,1)
            value = clampInc(minV + rel*(maxV-minV))
            render()
            if opts.Callback then pcall(opts.Callback, value) end
        end
        bar.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                upd(inp.Position.X)
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
            or inp.UserInputType == Enum.UserInputType.Touch) then
                upd(inp.Position.X)
            end
        end)
        UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        local api = {}
        function api:Set(v) value = clampInc(tonumber(v) or value); render() end
        return api
    end

    local WindowMethods = {}

    function WindowMethods:CreateTab(name)
        local tb = mk("TextButton", {
            Size = UDim2.new(1,0,0,28), BackgroundColor3 = T.panel2,
            BorderSizePixel = 0, Text = "", AutoButtonColor = false, Parent = self.__sidebar,
        })
        corner(tb, 5)
        local lbl = mk("TextLabel", {
            Size = UDim2.new(1,-12,1,0), Position = UDim2.new(0,6,0,0),
            BackgroundTransparency = 1, Text = name, TextColor3 = T.sub,
            Font = Enum.Font.Gotham, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = tb,
        })
        local page = mk("ScrollingFrame", {
            Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1,
            BorderSizePixel = 0, ScrollBarThickness = 4,
            ScrollBarImageColor3 = T.accent, CanvasSize = UDim2.new(0,0,0,0),
            Visible = false, Parent = self.__content,
        })
        local layout = mk("UIListLayout", {
            Padding = UDim.new(0,4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page,
        })
        mk("UIPadding", {
            PaddingTop = UDim.new(0,6), PaddingBottom = UDim.new(0,6),
            PaddingLeft = UDim.new(0,8), PaddingRight = UDim.new(0,8), Parent = page,
        })
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            page.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 16)
        end)
        local tab = setmetatable({__page = page, __btn = tb, __label = lbl}, {__index = TabMethods})
        tb.MouseButton1Click:Connect(function()
            for _, o in ipairs(self.__tabs) do
                o.__page.Visible = false
                o.__label.TextColor3 = T.sub
                o.__btn.BackgroundColor3 = T.panel2
            end
            page.Visible = true
            lbl.TextColor3 = T.text
            tb.BackgroundColor3 = T.accent2
        end)
        table.insert(self.__tabs, tab)
        if #self.__tabs == 1 then
            page.Visible = true
            lbl.TextColor3 = T.text
            tb.BackgroundColor3 = T.accent2
        end
        return tab
    end

    function WindowMethods:Destroy()
        if self.__gui then self.__gui:Destroy() end
        if activeWindow == self then activeWindow = nil end
    end

    function API:Notify(opts)
        if not API.__notifyGui or not API.__notifyGui.Parent then
            API.__notifyGui = mk("ScreenGui", {
                Name = "UFH_Notify", ResetOnSpawn = false,
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = parentGui(),
            })
        end
        local h = mk("Frame", {
            Size = UDim2.new(0,260,0,54),
            Position = UDim2.new(1,-280,0,#API.notifications*64 + 20),
            BackgroundColor3 = T.bg, BorderSizePixel = 0, Parent = API.__notifyGui,
        })
        corner(h, 7)
        mk("TextLabel", {
            Size = UDim2.new(1,-12,0,18), Position = UDim2.new(0,6,0,6),
            BackgroundTransparency = 1, Text = opts.Title or "",
            TextColor3 = T.accent, Font = Enum.Font.GothamBold, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = h,
        })
        mk("TextLabel", {
            Size = UDim2.new(1,-12,0,26), Position = UDim2.new(0,6,0,22),
            BackgroundTransparency = 1, Text = opts.Content or "",
            TextColor3 = T.text, Font = Enum.Font.Gotham, TextSize = 11,
            TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top, Parent = h,
        })
        table.insert(API.notifications, h)
        task.delay(opts.Duration or 4, function()
            for i,x in ipairs(API.notifications) do
                if x == h then table.remove(API.notifications, i); break end
            end
            if h.Parent then h:Destroy() end
            for i,x in ipairs(API.notifications) do
                x.Position = UDim2.new(1,-280,0,(i-1)*64 + 20)
            end
        end)
    end

    function API:CreateWindow(opts)
        if activeWindow then pcall(function() activeWindow:Destroy() end) end
        local gui = mk("ScreenGui", {
            Name = "UFH_" .. (opts.Name or "Window"),
            ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            Parent = parentGui(),
        })
        local root = mk("Frame", {
            Size = UDim2.new(0,500,0,340),
            Position = UDim2.new(0.5,-250,0.5,-170),
            BackgroundColor3 = T.bg, BorderSizePixel = 0, Active = true, Parent = gui,
        })
        corner(root, 10)
        mk("UIStroke", {Color = T.border, Thickness = 1}, root)
        draggable(root, root)
        local header = mk("Frame", {
            Size = UDim2.new(1,0,0,36), BackgroundColor3 = T.panel,
            BorderSizePixel = 0, Parent = root,
        })
        corner(header, 10)
        mk("TextLabel", {
            Size = UDim2.new(1,-40,1,0), Position = UDim2.new(0,12,0,0),
            BackgroundTransparency = 1, Text = opts.Name or "Window",
            TextColor3 = T.text, Font = Enum.Font.GothamBold, TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = header,
        })
        local close = mk("TextButton", {
            Size = UDim2.new(0,26,0,26), Position = UDim2.new(1,-32,0.5,-13),
            BackgroundColor3 = T.panel2, Text = "x", TextColor3 = T.text,
            Font = Enum.Font.GothamBold, TextSize = 15, AutoButtonColor = false, Parent = header,
        })
        corner(close, 5)
        close.MouseButton1Click:Connect(function() gui.Enabled = false end)
        local sidebar = mk("Frame", {
            Size = UDim2.new(0,120,1,-44), Position = UDim2.new(0,6,0,42),
            BackgroundColor3 = T.panel, BorderSizePixel = 0, Parent = root,
        })
        corner(sidebar, 8)
        mk("UIListLayout", {Padding = UDim.new(0,4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = sidebar})
        mk("UIPadding", {PaddingTop = UDim.new(0,6), PaddingLeft = UDim.new(0,6), PaddingRight = UDim.new(0,6), Parent = sidebar})
        local content = mk("Frame", {
            Size = UDim2.new(1,-136,1,-44), Position = UDim2.new(0,130,0,42),
            BackgroundColor3 = T.panel, BorderSizePixel = 0, Parent = root,
        })
        corner(content, 8)
        local W = setmetatable({
            __gui = gui, __root = root, __sidebar = sidebar,
            __content = content, __tabs = {},
        }, {__index = WindowMethods})
        activeWindow = W
        return W
    end

    function API:Destroy()
        if activeWindow then
            pcall(function() activeWindow:Destroy() end)
            activeWindow = nil
        end
    end

    return API
end

