    local lookFlat = Vector3.new(look.X, 0, look.Z)
    if lookFlat.Magnitude > 0.01 then lookFlat = lookFlat.Unit else lookFlat = Vector3.new(0,0,1) end
    local best, bestScore = nil, -math.huge
    for _, r in ipairs(receivers) do
        local dist = (r.hrp.Position - myPos).Magnitude
        if dist <= qbMaxDist then
            local open = qbOpenness(r)
            if open >= qbMinOpenness then
                local toR = r.hrp.Position - myPos
                local toRFlat = Vector3.new(toR.X, 0, toR.Z)
                local fwdDot = toRFlat.Magnitude > 0.01 and toRFlat.Unit:Dot(lookFlat) or 0
                local v = r.hrp.AssemblyLinearVelocity
                local spd = Vector3.new(v.X, 0, v.Z).Magnitude
                local score
                if qbMode == "Fastest" then
                    score = spd
                elseif qbMode == "Lob" then
                    if qbIsGoRoute(r, myPos) then
                        score = 1000 + open * 2 - dist * 0.3
                    else
                        score = open - dist * 0.5 + fwdDot * 20
                    end
                else
                    score = open * 2 - dist * 0.5 + fwdDot * 30
