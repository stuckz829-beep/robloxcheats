local function trySwat(_, ballPosOverride)
    if not autoRushUnlocked or not autoRushActive then return end
    if not humanoid or not hrp or isFlying or stickyTarget or holdingFootball() then return end
    local now = tick()
    if now - lastSwatAt < SWAT_COOLDOWN then return end
    local bp = ballPosOverride
    if not bp then
        local ball = findFootball and findFootball()
        bp = ballPos(ball)
    end
    if not bp then return end
    if (bp - hrp.Position).Magnitude > SWAT_RANGE then return end
    lastSwatAt = now
    local flat = Vector3.new(bp.X - hrp.Position.X, 0, bp.Z - hrp.Position.Z)
    if flat.Magnitude > 0.5 then
        local vel = hrp.AssemblyLinearVelocity
        hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + flat.Unit)
        hrp.AssemblyLinearVelocity = vel
    end
    pressKey(Enum.KeyCode.Space)
    if humanoid then
        pcall(function() humanoid.Jump = true end)
    end
end

local function clearThrowWatch()
    if carrierThrowConn then pcall(function() carrierThrowConn:Disconnect() end); carrierThrowConn = nil end
    lastCarrierForThrowWatch = nil
    throwWatchBallPrevPos = nil
end

local function installThrowWatch(char)
    if not char then return end
    if lastCarrierForThrowWatch == char and carrierThrowConn then return end
    clearThrowWatch()
    lastCarrierForThrowWatch = char
    carrierThrowConn = char.ChildRemoved:Connect(function(child)
        if not alive or child.Name ~= FOOTBALL_NAME then return end
        local bp = ballPos(child)
        if not bp and findFootball then bp = ballPos(findFootball()) end
        if bp then trySwat("childremoved", bp) end
    end)
end

local function bindCarrierTracking(char)
    if not char then return end
    track(char.ChildAdded:Connect(function(child)
        if not alive then return end
        if child.Name == FOOTBALL_NAME and char ~= localPlayer.Character then
            ballCarrierChar = char
            installThrowWatch(char)
        end
    end))
    track(char.ChildRemoved:Connect(function(child)
        if not alive or child.Name ~= FOOTBALL_NAME then return end
        if ballCarrierChar == char then ballCarrierChar = nil end
        if char ~= localPlayer.Character then
            local bp = ballPos(child)
            if not bp and findFootball then bp = ballPos(findFootball()) end
            if bp then trySwat("released", bp) end
        end
        if lastCarrierForThrowWatch == char then clearThrowWatch() end
    end))
    if char:FindFirstChild(FOOTBALL_NAME) and char ~= localPlayer.Character then
        ballCarrierChar = char
        installThrowWatch(char)
    end
end

