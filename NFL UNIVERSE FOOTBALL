-- Ultimate Football Hub 2026 (Lag-Optimized Anti-Bounce)
getgenv().SecureMode = true

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

-------------------------------------------------
-- VARIABLES
-------------------------------------------------
local walkSpeed = 18
local gravityVal = 196.2

-- Flight
local isFlying = false
local flySpeed = 50
local flyVelocity = Vector3.zero
local flyAccel, flyFriction = 8, 6

-- Side Tech (Exact Logic Reverted)
local autoSideTechEnabled = false
local isHoldingSideTech = false
local sideTechTargetLookVector = nil
local SIDE_TECH_ANIM_ID = "rbxassetid://8839176574"
local sideTechAnimPlaying = false

-- Head Tech
local isHeadModEnabled = false
local targetHeadScale = 5
local lastJumpTime = 0

-- Pull Vector
local pullVectorEnabled = false
local pullSpeed = 45     -- Velocity speed applied during pull
local isHoldingM1 = false  -- Tracks if MouseButton1 is strictly held down

local humanoid, hrp

-------------------------------------------------
-- UTILS
-------------------------------------------------
local function isShiftLocked()
    return UIS.MouseBehavior == Enum.MouseBehavior.LockCenter
end

local function findFootball()
    local char = localPlayer.Character
    if char and char:FindFirstChild("Football") then
        return char:FindFirstChild("Football")
    end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("Football") then
            return p.Character:FindFirstChild("Football")
        end
    end
    
    return workspace:FindFirstChild("Football", true)
end

local function hookChar(char)
    humanoid = char:WaitForChild("Humanoid")
    hrp = char:WaitForChild("HumanoidRootPart")
    
    local animator = humanoid:WaitForChild("Animator")
    animator.AnimationPlayed:Connect(function(track)
        if track.Animation and track.Animation.AnimationId == SIDE_TECH_ANIM_ID then
            sideTechAnimPlaying = true
            track.Stopped:Once(function() sideTechAnimPlaying = false end)
        end
    end)
    
    humanoid.Jumping:Connect(function() lastJumpTime = tick() end)
end

if localPlayer.Character then hookChar(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(hookChar)

-- Pre-allocate RaycastParams to save memory/CPU
local rayParam = RaycastParams.new()
rayParam.FilterType = Enum.RaycastFilterType.Exclude

-------------------------------------------------
-- INPUT
-------------------------------------------------
UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        isHoldingM1 = true
        
        if autoSideTechEnabled and not isShiftLocked() then
            local camLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
            sideTechTargetLookVector = Vector3.new(-camLook.Z, 0, camLook.X)
            isHoldingSideTech = true
        end
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        isHoldingM1 = false
        isHoldingSideTech = false
        sideTechTargetLookVector = nil
    end
end)

-------------------------------------------------
-- HEARTBEAT
-------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
    if not hrp or not humanoid then return end

    -- Gravity Lock
    if workspace.Gravity ~= gravityVal then workspace.Gravity = gravityVal end

    -- Side Tech Execution
    if isHoldingSideTech and sideTechTargetLookVector and not isShiftLocked() and not sideTechAnimPlaying then
        local vel = hrp.AssemblyLinearVelocity
        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + sideTechTargetLookVector)
        hrp.AssemblyLinearVelocity = vel
    end

    -- Pull Vector Mechanics (With Catch Detection Fix)
    if pullVectorEnabled and isHoldingM1 and not isFlying then
        local ball = findFootball()
        local ballPart = ball and (ball:IsA("BasePart") and ball or ball:FindFirstChildWhichIsA("BasePart", true))
        
        if ballPart then
            local direction = (ballPart.Position - hrp.Position)
            local currentDistance = direction.Magnitude
            
            -- CATCH FIX: If you are closer than 4.5 studs, KILL velocity instantly 
            -- This allows your hitbox to cleanly interact with the ball instead of phasing through it.
            if currentDistance <= 4.5 then
                hrp.AssemblyLinearVelocity = Vector3.zero
            elseif currentDistance > 2 then
                -- Direct positional velocity shift when out of catch range
                hrp.AssemblyLinearVelocity = direction.Unit * pullSpeed
            end
        end
    end

    -- Flight
    if isFlying then
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        local move = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then move += camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += camera.CFrame.RightVector end
        flyVelocity = (move.Magnitude > 0) and flyVelocity:Lerp(move.Unit * flySpeed, flyAccel * dt) or flyVelocity:Lerp(Vector3.zero, flyFriction * dt)
        hrp.AssemblyLinearVelocity = flyVelocity
    end

    -- HEAD COLLISION (GLOBAL SERVER SCAN)
    local headTechActive = isHeadModEnabled and (tick() - lastJumpTime >= 0.15)
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local char = p.Character
        local head = char and char:FindFirstChild("Head")
        if not head then continue end

        if not head:FindFirstChild("OrigSize") then
            local v = Instance.new("Vector3Value", head)
            v.Name = "OrigSize"
            v.Value = head.Size
        end

        local targetSize = headTechActive and Vector3.new(targetHeadScale, head.OrigSize.Value.Y, targetHeadScale) or head.OrigSize.Value
        if head.Size ~= targetSize then 
            head.Size = targetSize
        end
        
        local targetTrans = headTechActive and 0.5 or 0
        if head.Transparency ~= targetTrans then
            head.Transparency = targetTrans
        end

        -- Anti-Bounce Detection
        rayParam.FilterDescendantsInstances = {localPlayer.Character}
        local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -3.5, 0), rayParam)
        local standingOnThisHead = (ray and ray.Instance == head)

        if sideTechAnimPlaying or isHoldingSideTech then
            if head.CanCollide then head.CanCollide = false end
        elseif standingOnThisHead then
            if not head.CanCollide then head.CanCollide = true end
        else
            local shouldCollide = headTechActive and (humanoid:GetState() == Enum.HumanoidStateType.Freefall or humanoid:GetState() == Enum.HumanoidStateType.Jumping)
            if head.CanCollide ~= shouldCollide then
                head.CanCollide = shouldCollide
            end
        end
    end
end)

-------------------------------------------------
-- GUI
-------------------------------------------------
local Window = Rayfield:CreateWindow({
    Name = "Ultimate Football Hub 2026",
    LoadingTitle = "Lag-Free Optimization",
    ConfigurationSaving = { Enabled = true }
})

local MainTab = Window:CreateTab("Movement")
local TechTab = Window:CreateTab("Head Tech")

MainTab:CreateSection("Basic Movement")
MainTab:CreateSlider({Name="WalkSpeed", Range={18,150}, Increment=1, CurrentValue=18, Callback=function(v) walkSpeed=v if humanoid then humanoid.WalkSpeed=v end end})
MainTab:CreateSlider({Name="Gravity", Range={0,196.2}, Increment=1, CurrentValue=196.2, Callback=function(v) gravityVal=v end})

MainTab:CreateSection("Flight Tech")
MainTab:CreateToggle({Name="Enable Flight", Callback=function(v) isFlying=v end})
MainTab:CreateSlider({Name="Flight Speed", Range={10,300}, Increment=5, CurrentValue=50, Callback=function(v) flySpeed=v end})

MainTab:CreateSection("Pull Vector Options")
MainTab:CreateToggle({Name="Enable Pull Vector", Callback=function(v) pullVectorEnabled=v end})
MainTab:CreateSlider({Name="Pull Vector Speed", Range={10, 150}, Increment=5, CurrentValue=45, Callback=function(v) pullSpeed=v end})

TechTab:CreateToggle({Name="Enable Delayed Head Size", Callback=function(v) isHeadModEnabled=v end})
TechTab:CreateSlider({Name="Head Scale", Range={1,15}, Increment=0.5, CurrentValue=5, Callback=function(v) targetHeadScale=v end})
TechTab:CreateToggle({Name="Auto Side Tech (HOLD M1)", Callback=function(v) autoSideTechEnabled=v end})

Rayfield:Notify({
    Title = "Performance Update",
    Content = "Catch physics anti-clip protection added.",
    Duration = 5
})
