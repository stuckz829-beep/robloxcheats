local function isShiftLocked() return UIS.MouseBehavior == Enum.MouseBehavior.LockCenter end
local function anyMoveKeyDown()
    return UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.A)
        or UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.D)
end
local function holdingFootball()
    local char = localPlayer.Character
    if not char then return false end
    return char:FindFirstChild(FOOTBALL_NAME) ~= nil
end
local function targetHasFootball(char)
    if not char then return false end
    return char:FindFirstChild(FOOTBALL_NAME) ~= nil
end
local function targetInBadState(char)
    if not char or char.Parent ~= workspace then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return true end
    return false
end

local function resolveBallPart(ball)
    if not ball then return nil end
    if ball:IsA("BasePart") then return ball end
    if ball:IsA("Tool") then
        local h = ball:FindFirstChild("Handle")
        if h and h:IsA("BasePart") then return h end
    end
    if ball:IsA("Model") then
        local pp = ball.PrimaryPart
        if pp then return pp end
    end
    return ball:FindFirstChildWhichIsA("BasePart", true)
end
local function ballPos(ball)
    local part = resolveBallPart(ball)
    return part and part.Position or nil
end

local function effectiveHeadSize(head)
    local orig = origSizes[head] or head.Size
    if isHeadModEnabled then return Vector3.new(targetHeadScale, orig.Y, targetHeadScale) end
    return orig
end

local function getFeetY()
    if not hrp or not humanoid then return nil end
    local hipHeight = humanoid.HipHeight or 2.0
    return hrp.Position.Y - hipHeight
end

local function feetOverHead(head, horizMargin, vertTolerance)
    if not head or not head.Parent then return false end
    if not hrp or not humanoid then return false end
    if holdingFootball() then return false end
    if targetHasFootball(head.Parent) then return false end
    local eff = effectiveHeadSize(head)
    local headTop = head.Position.Y + eff.Y * 0.5
    local feetY = getFeetY()
    if not feetY then return false end
    local dx = hrp.Position.X - head.Position.X
    local dz = hrp.Position.Z - head.Position.Z
    local horizDist = math.sqrt(dx*dx + dz*dz)
    local radius = math.max(eff.X * 0.5, eff.Z * 0.5) + horizMargin
    if horizDist > radius then return false end
    return feetY >= (headTop - vertTolerance)
end

local function withinStickyRange(head)
    if not head or not head.Parent then return false end
    if not hrp or not humanoid then return false end
    if holdingFootball() then return false end
    if targetHasFootball(head.Parent) then return false end
    local eff = effectiveHeadSize(head)
    local headBottom = head.Position.Y - eff.Y * 0.5
    local feetY = getFeetY()
    if not feetY then return false end
    if feetY < headBottom then return false end
    local dx = hrp.Position.X - head.Position.X
    local dz = hrp.Position.Z - head.Position.Z
    local horizDist = math.sqrt(dx*dx + dz*dz)
    local radius = math.max(eff.X * 0.5, eff.Z * 0.5) + FEET_OVER_HEAD_HORIZ_MARGIN
    return horizDist <= radius
end

-- Dive detection: either the side-tech animation is playing, or the target
-- HRP has a strong downward velocity. Cached briefly so we don't spam.
local function characterIsDiving(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        local now = tick()
        local rec = targetDiveCache[hum]
        if not rec or now >= rec.next then
            local diving = false
            local animator = char:FindFirstChildOfClass("Animator")
            if animator then
                for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
                    if tr.Animation and tr.Animation.AnimationId == SIDE_TECH_ANIM_ID then
                        diving = true; break
                    end
                end
            end
            targetDiveCache[hum] = {diving = diving, next = now + 0.05}
        end
        if targetDiveCache[hum].diving then return true end
    end
    -- Fast downward HRP motion = diving/tackling.
    local h = char:FindFirstChild("HumanoidRootPart")
    if h and h.AssemblyLinearVelocity.Y <= STICKY_DIVE_Y_VELOCITY then
        return true
    end
    return false
end

local function findFeetOverHead(horizMargin, vertTolerance)
    if not hrp or holdingFootball() then return nil end
    local bestHead, bestDist = nil, math.huge
    for i = 1, #cachedPlayers do
        local p = cachedPlayers[i]
        if p ~= localPlayer then
            local c = p.Character
            if c and c.Parent and not characterIsDiving(c) then
                local head = headCache[p]
                if head and head.Parent and feetOverHead(head, horizMargin, vertTolerance) then
                    local dx = head.Position.X - hrp.Position.X
                    local dz = head.Position.Z - hrp.Position.Z
                    local d = math.sqrt(dx*dx + dz*dz)
                    if d < bestDist then bestDist = d; bestHead = head end
                end
            end
        end
    end
    return bestHead
end

local function findHeadInStickyRange()
    if not hrp or holdingFootball() then return nil end
    local bestHead, bestDist = nil, math.huge
    for i = 1, #cachedPlayers do
        local p = cachedPlayers[i]
        if p ~= localPlayer then
            local c = p.Character
            if c and c.Parent and not characterIsDiving(c) then
                local head = headCache[p]
                if head and head.Parent and withinStickyRange(head) then
                    local dx = head.Position.X - hrp.Position.X
                    local dz = head.Position.Z - hrp.Position.Z
                    local d = math.sqrt(dx*dx + dz*dz)
                    if d < bestDist then bestDist = d; bestHead = head end
                end
            end
        end
    end
    return bestHead
end

local function rocketHeadCheckNow()
    if not hrp or not humanoid or holdingFootball() then return nil end
    local hipHeight = humanoid.HipHeight or 2.0
    local feetY = hrp.Position.Y - hipHeight
    local hrpPos = hrp.Position
    for i = 1, #cachedPlayers do
        local p = cachedPlayers[i]
        if p ~= localPlayer then
            local head = headCache[p]
            if head and head.Parent then
                local sz = head.Size
                local headTop = head.Position.Y + sz.Y * 0.5
                local headBottom = head.Position.Y - sz.Y * 0.5
                if feetY >= (headBottom - ROCKET_VERT_BELOW)
                and feetY <= (headTop + ROCKET_VERT_ABOVE) then
                    local dx = math.abs(head.Position.X - hrpPos.X)
                    local dz = math.abs(head.Position.Z - hrpPos.Z)
                    local hx = sz.X * 0.5 + ROCKET_HORIZ_MARGIN
                    local hz = sz.Z * 0.5 + ROCKET_HORIZ_MARGIN
                    if dx <= hx and dz <= hz then return head end
                end
            end
        end
    end
    return nil
end

local function isOnHeadForRocketBoost()
    local live = rocketHeadCheckNow()
    if live then
        lastOnHeadAt = tick()
        lastOnHeadRef = live
        return live
    end
    if lastOnHeadRef and lastOnHeadRef.Parent and (tick() - lastOnHeadAt) <= ROCKET_GRACE then
        return lastOnHeadRef
    end
    return nil
end

local function findClosestBallCarrier()
    if not hrp then return nil end
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge
    for i = 1, #cachedPlayers do
        local p = cachedPlayers[i]
        if p ~= localPlayer then
            local c = p.Character
            if c and c.Parent and c:FindFirstChild(FOOTBALL_NAME) then
                local h = c:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (h.Position - myPos).Magnitude
                    if d < bestDist then bestDist = d; best = c end
                end
            end
        end
    end
    return best
end

local function getBallCarrier() return findClosestBallCarrier() end

local function diveDirection()
    if humanoid then
        local md = humanoid.MoveDirection
        local flat = Vector3.new(md.X, 0, md.Z)
        if flat.Magnitude > 0.01 then return flat.Unit end
    end
    if hrp then
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > 0.01 then return flat.Unit end
    end
    local look = camera.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude > 0.01 then return flat.Unit end
    return Vector3.new(0, 0, -1)
end

