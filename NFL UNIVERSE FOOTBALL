local function targetHeadDiving(head)
    if not head or not head.Parent then return false end
    local char = head.Parent
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local now = tick()
    local nextAt = targetDivingRefresh[hum] or 0
    if now >= nextAt then
        targetDivingRefresh[hum] = now + 0.08
        targetDivingCache[hum] = characterIsDiving(char)
    end
    return targetDivingCache[hum] == true
end

local function targetIsMovingNormally(char)
    if not char then return false end
    if targetHasFootball(char) then return false end
    if characterIsDiving(char) then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local state = hum:GetState()
    return OK_TARGET_STATES[state] == true
end

local function diveDirection()
    if humanoid then
        local md = humanoid.MoveDirection
        local flat = Vector3.new(md.X, 0, md.Z)
        if flat.Magnitude > 0.01 then return flat.Unit end
    end
    if hrp then
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > 0.01 then return flat.Unit end
    end
    local look = camera.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude > 0.01 then return flat.Unit end
    return Vector3.new(0, 0, -1)
end

local function ballPos(ball)
    if not ball then return nil end
    if ball:IsA("BasePart") then return ball.Position end
    if ball:IsA("Model") or ball:IsA("Tool") then
        local pp = ball.PrimaryPart
        if pp then return pp.Position end
        local ok, pivot = pcall(function() return ball:GetPivot() end)
        if ok and pivot then return pivot.Position end
        if ball:IsA("Tool") then
            local h = ball:FindFirstChild("Handle")
            if h and h:IsA("BasePart") then return h.Position end
        end
    end
    local part = ball:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position end
    return nil
end

