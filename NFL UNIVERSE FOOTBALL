    if type(data.rocketBoostChance) == "number" then rocketBoostChance = data.rocketBoostChance; sS("rocketBoostChance", data.rocketBoostChance) end
    if type(data.stickyHeadEnabled) == "boolean" then stickyHeadEnabled = data.stickyHeadEnabled; sT("stickyHeadEnabled", data.stickyHeadEnabled) end
