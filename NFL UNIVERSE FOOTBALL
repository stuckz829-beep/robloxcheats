-- AUTO RUSH
-------------------------------------------------
local function stopActiveRush()
    autoRushActive = false
    if humanoid then pcall(function() humanoid:Move(V3_ZERO, false) end) end
end

local function disableAutoRush()
    autoRushUnlocked = false
    stopActiveRush()
end

local function toggleActiveRush()
    if not autoRushUnlocked then return end
    if not autoRushAllowed() then
        Rayfield:Notify({Title="Auto Rush", Content="WalkSpeed must be 22 or higher.", Duration=3})
        return
    end
    task.defer(function()
        if autoRushActive then
            stopActiveRush()
            Rayfield:Notify({Title="Auto Rush", Content="Off", Duration=2})
        else
            autoRushActive = true
            Rayfield:Notify({Title="Auto Rush", Content="On", Duration=2})
        end
    end)
end

local function rushTargetPos()
    local carrier = getBallCarrier()
    if carrier and carrier.Parent then
        local theirHrp = carrier:FindFirstChild("HumanoidRootPart")
        if theirHrp then
            local theirPos = theirHrp.Position
            local vel = theirHrp.AssemblyLinearVelocity
            local flatVel = Vector3.new(vel.X, 0, vel.Z)

            if hrp and flatVel.Magnitude > 3 then
                local myPos = hrp.Position
                local mySpeed = walkSpeed
                if mySpeed < 16 then mySpeed = 16 end

                local toQB = Vector3.new(theirPos.X - myPos.X, 0, theirPos.Z - myPos.Z)
                local a = flatVel.Magnitude^2 - mySpeed^2
                local b = 2 * toQB:Dot(flatVel)
                local c = toQB.Magnitude^2

                local tIntercept = nil
                if math.abs(a) < 0.01 then
                    if math.abs(b) > 0.01 then
                        local tt = -c / b
                        if tt > 0 then tIntercept = tt end
                    end
                else
                    local disc = b*b - 4*a*c
                    if disc >= 0 then
                        local sq = math.sqrt(disc)
                        local t1 = (-b + sq) / (2*a)
                        local t2 = (-b - sq) / (2*a)
                        if t1 > 0 and (not tIntercept or t1 < tIntercept) then tIntercept = t1 end
                        if t2 > 0 and (not tIntercept or t2 < tIntercept) then tIntercept = t2 end
                    end
                end

                if tIntercept and tIntercept > 0.02 and tIntercept <= RUSH_INTERCEPT_MAX then
                    return theirPos + flatVel * tIntercept
                end
            end

            return theirPos
        end
    end
    local ball = findFootball()
    return ballPos(ball)
end

