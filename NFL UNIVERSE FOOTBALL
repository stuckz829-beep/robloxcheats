local function bindCharacter(player, char)
    task.spawn(function()
        local head = char:FindFirstChild("Head")
        while not head and char.Parent do
            char.ChildAdded:Wait()
            head = char:FindFirstChild("Head")
        end
        if not head or not char.Parent then return end
        headCache[player] = head
        applyHeadNow(head)
    end)
end

local function silenceHumanoid()
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end
    for _, state in ipairs({
        Enum.HumanoidStateType.Freefall,
        Enum.HumanoidStateType.Jumping,
        Enum.HumanoidStateType.FallingDown,
        Enum.HumanoidStateType.Ragdoll,
        Enum.HumanoidStateType.PlatformStanding,
    }) do
        if humanoid:GetStateEnabled(state) then
            humanoid:SetStateEnabled(state, false)
            disabledStates[state] = true
        end
    end
    if savedWalkSpeed == nil then savedWalkSpeed = humanoid.WalkSpeed end
    if savedJumpPower == nil then savedJumpPower = humanoid.JumpPower end
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.JumpHeight = 0
    humanoid.PlatformStand = true
    humanoid:ChangeState(Enum.HumanoidStateType.Running)
end

local function unsilenceHumanoid()
    if not humanoid then return end
    for state, _ in pairs(disabledStates) do
        humanoid:SetStateEnabled(state, true)
    end
    disabledStates = {}
    if savedWalkSpeed ~= nil then
        humanoid.WalkSpeed = savedWalkSpeed
        savedWalkSpeed = nil
    end
    if savedJumpPower ~= nil then
        humanoid.JumpPower = savedJumpPower
        savedJumpPower = nil
    end
    humanoid.PlatformStand = false
end

local function detachTargetAnimListener()
    if targetAnimConn then
        pcall(function() targetAnimConn:Disconnect() end)
        targetAnimConn = nil
    end
end

local function watchTargetForDive(target)
    detachTargetAnimListener()
    if not target or not target.Character then return end
    local animator = target.Character:FindFirstChildOfClass("Animator")
    if not animator then return end
    targetAnimConn = animator.AnimationPlayed:Connect(function(track)
        if track.Animation and track.Animation.AnimationId == SIDE_TECH_ANIM_ID then
            stickyReleaseInput = true
        end
    end)
end

detachSticky = function()
    local prevHead = stickyTarget

    stickyTarget = nil
    stickyReleaseInput = false
    stickyCooldown = REATTACH_COOLDOWN
    attachTime = 0

    detachTargetAnimListener()

    unsilenceHumanoid()
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    if prevHead and prevHead.Parent then
        prevHead.CanCollide = true
    end
end

local function attachSticky(head)
    stickyTarget = head
    stickyReleaseInput = false
    attachTime = tick()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    silenceHumanoid()

    if head and head.Parent then
        local char = head.Parent
        local player = Players:GetPlayerFromCharacter(char)
        if player then
            watchTargetForDive(player)
        end
    end
end

local function hookChar(char)
    humanoid = char:WaitForChild("Humanoid")
    hrp = char:WaitForChild("HumanoidRootPart")

    local animator = humanoid:WaitForChild("Animator")
    animator.AnimationPlayed:Connect(function(track)
        if track.Animation and track.Animation.AnimationId == SIDE_TECH_ANIM_ID then
            sideTechAnimPlaying = true
            if stickyTarget then
                detachSticky()
            end
            track.Stopped:Once(function() sideTechAnimPlaying = false end)
        end
    end)

    humanoid.Jumping:Connect(function()
        lastJumpTime = tick()
        if stickyTarget then stickyReleaseInput = true end
    end)

    humanoid.Died:Connect(function()
        stickyTarget = nil
        stickyReleaseInput = false
        if humanoid then
            humanoid.PlatformStand = false
            for state, _ in pairs(disabledStates) do
                humanoid:SetStateEnabled(state, true)
            end
            disabledStates = {}
            if savedWalkSpeed then humanoid.WalkSpeed = savedWalkSpeed end
            if savedJumpPower then humanoid.JumpPower = savedJumpPower end
        end
    end)
end

