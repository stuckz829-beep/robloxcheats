    if type(data.jumpBoostChance) == "number" then jumpBoostChance = data.jumpBoostChance; sS("jumpBoostChance", data.jumpBoostChance) end
    if type(data.noclipEnabled) == "boolean" then noclipEnabled = data.noclipEnabled; sT("noclipEnabled", data.noclipEnabled) end
