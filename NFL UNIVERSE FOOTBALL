        humanoid.WalkSpeed = walkSpeed
    end
end

local function installWalkSpeedLock(hum)
    if walkSpeedConn then
        pcall(function() walkSpeedConn:Disconnect() end)
        walkSpeedConn = nil
    end
    if not hum then return end
    walkSpeedConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if not alive then return end
        if walkSpeedLockSuspended then return end
        if not lockActive() then return end
        if not humanoid then return end
        if humanoid.WalkSpeed ~= walkSpeed then
            humanoid.WalkSpeed = walkSpeed
        end
    end)
end

