local function disableAutoRush()
    autoRushUnlocked = false
    stopActiveRush()
end

local function toggleActiveRush()
    if not autoRushUnlocked then return end
    if not autoRushAllowed() then
        Rayfield:Notify({Title="Auto Rush", Content="WalkSpeed must be 21 or higher.", Duration=3})
        return
    end
    task.defer(function()
        if autoRushActive then
            stopActiveRush()
            Rayfield:Notify({Title="Auto Rush", Content="Off", Duration=2})
        else
            if stickyTarget then detachSticky() end
            for k in pairs(proxyEngaged) do proxyEngaged[k] = nil end
            autoRushActive = true
            rushEngageStartAt = 0
            lastRushCarrier = nil
            local carrier = getBallCarrier()
            if carrier then
                lastRushCarrier = carrier
                rushEngageStartAt = tick()
            end
            Rayfield:Notify({Title="Auto Rush", Content="On", Duration=2})
        end
    end)
end

local function rushTargetPos()
    local carrier = getBallCarrier()
    if not carrier then
        if lastRushCarrier ~= nil then
            lastRushCarrier = nil
            rushEngageStartAt = 0
        end
        return ballPos(findFootball and findFootball())
    end
    if carrier ~= lastRushCarrier or rushEngageStartAt == 0 then
        lastRushCarrier = carrier
        rushEngageStartAt = tick()
    end
    local theirHrp = carrier:FindFirstChild("HumanoidRootPart")
    if not theirHrp then return ballPos(findFootball and findFootball()) end
    local theirPos = theirHrp.Position
    if not hrp then return theirPos + QB_CHEST_OFFSET end
    local chest = theirPos + QB_CHEST_OFFSET
    local myPos = hrp.Position
    local vel = theirHrp.AssemblyLinearVelocity
    local flatVel = Vector3.new(vel.X, 0, vel.Z)
    local speed = flatVel.Magnitude
    if speed < 1.0 then return chest end
    local hisDir = flatVel / speed
    local toHim = Vector3.new(theirPos.X - myPos.X, 0, theirPos.Z - myPos.Z)
    local dist = toHim.Magnitude
    if dist < 0.01 then return chest end
    local mySpeed = walkSpeed
    if mySpeed < 1 then mySpeed = 1 end
    local a = speed*speed - mySpeed*mySpeed
    local b = 2 * toHim:Dot(flatVel)
    local c = dist * dist
    local tIntercept = nil
    if math.abs(a) < 1e-4 then
        if math.abs(b) > 1e-4 then
            local t = -c / b
            if t > 0 then tIntercept = t end
        end
    else
        local disc = b*b - 4*a*c
        if disc >= 0 then
            local sq = math.sqrt(disc)
            local t1 = (-b + sq) / (2*a)
            local t2 = (-b - sq) / (2*a)
            if t1 > 0 and (not tIntercept or t1 < tIntercept) then tIntercept = t1 end
            if t2 > 0 and (not tIntercept or t2 < tIntercept) then tIntercept = t2 end
        end
    end
    if not tIntercept or tIntercept <= 0 then tIntercept = 0.6 end
    tIntercept = math.clamp(tIntercept, RUSH_T_MIN, RUSH_T_MAX)
    local aim = chest + flatVel * (tIntercept * RUSH_OVERSHOOT)
    local forwardFromHim = (aim - theirPos):Dot(hisDir)
    if forwardFromHim < RUSH_FORWARD_MIN then
        aim = aim + hisDir * (RUSH_FORWARD_MIN - forwardFromHim)
    end
    local aimVec = aim - theirPos
    local aimLen = aimVec.Magnitude
    if aimLen > dist then aim = theirPos + aimVec.Unit * dist end
    return aim
end

