local function raycastFloorYawOnly(fromCFrame, charToIgnore)
    local origin = fromCFrame.Position + Vector3.new(0, 6, 0)
    local dir = Vector3.new(0, -60, 0)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {}
    if charToIgnore then
        for _, d in ipairs(charToIgnore:GetDescendants()) do
            if d:IsA("BasePart") then ignore[#ignore + 1] = d end
        end
    end
    if localPlayer.Character then
        for _, d in ipairs(localPlayer.Character:GetDescendants()) do
            if d:IsA("BasePart") then ignore[#ignore + 1] = d end
        end
    end
    params.FilterDescendantsInstances = ignore
    local hit = workspace:Raycast(origin, dir, params)

    local look = fromCFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude < 0.001 then
        flatLook = Vector3.new(0, 0, -1)
    else
        flatLook = flatLook.Unit
    end

    local basePos
    if hit then
        basePos = hit.Position + Vector3.new(0, 3.0, 0)
    else
        basePos = fromCFrame.Position
    end

    return CFrame.lookAt(basePos, basePos + flatLook)
end

local function pinRefresh()
    if not refreshPinning then return end
    local char = refreshPinChar
    if not char or char ~= localPlayer.Character then
        refreshPinning = false
        refreshPinChar = nil
        refreshPinCF = nil
        return
    end
    local h = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not h or not hum then return end

    pcall(function() h.CFrame = refreshPinCF end)
    pcall(function()
        h.AssemblyLinearVelocity = V3_ZERO
        h.AssemblyAngularVelocity = V3_ZERO
    end)
    if hum.PlatformStand then hum.PlatformStand = false end
    if hum.Sit then hum.Sit = false end
    local st = hum:GetState()
    if st == Enum.HumanoidStateType.Physics
    or st == Enum.HumanoidStateType.FallingDown
    or st == Enum.HumanoidStateType.Ragdoll
    or st == Enum.HumanoidStateType.Freefall then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
    end
    hum:Move(V3_ZERO, false)
end

local function refreshCharacter()
    local char = localPlayer.Character
    if not char then
        Rayfield:Notify({Title="Refresh", Content="No character to refresh.", Duration=3})
        return
    end
    local h = char:FindFirstChild("HumanoidRootPart")
    if h then
        savedRefreshCFrame = h.CFrame
    else
        savedRefreshCFrame = nil
    end
    if stickyTarget then detachSticky() end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
        pcall(function() hum.Health = 0 end)
    end

    task.spawn(function()
        task.wait(0.2)
        if localPlayer.Character == char then
            pcall(function() char:BreakJoints() end)
        end
        task.wait(0.6)
        if localPlayer.Character == char then
            savedRefreshCFrame = nil
            Rayfield:Notify({Title="Refresh", Content="Server blocked the reset.", Duration=4})
        end
    end)
end

track(localPlayer.CharacterAdded:Connect(function(char)
    if not alive then return end
    if not savedRefreshCFrame then return end
    local savedCF = savedRefreshCFrame
    savedRefreshCFrame = nil

    task.spawn(function()
        local h = char:WaitForChild("HumanoidRootPart", 5)
        if not h then return end
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end

