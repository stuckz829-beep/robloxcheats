-------------------------------------------------
-- UTILS
-------------------------------------------------
local function isShiftLocked()
    return UIS.MouseBehavior == Enum.MouseBehavior.LockCenter
end

local function anyMoveKeyDown()
    return UIS:IsKeyDown(Enum.KeyCode.W)
        or UIS:IsKeyDown(Enum.KeyCode.A)
        or UIS:IsKeyDown(Enum.KeyCode.S)
        or UIS:IsKeyDown(Enum.KeyCode.D)
end

local function isAirborne()
    if not humanoid then return false end
    local state = humanoid:GetState()
    return state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.Jumping
end

local function diveDirection()
    if humanoid then
        local md = humanoid.MoveDirection
        local flat = Vector3.new(md.X, 0, md.Z)
        if flat.Magnitude > 0.01 then
            return flat.Unit
        end
    end
    if hrp then
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > 0.01 then
            return flat.Unit
        end
    end
    local look = camera.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude > 0.01 then return flat.Unit end
    return Vector3.new(0, 0, -1)
end

-- get world position of the football object (Model/Tool/Folder/Part)
local function ballPos(ball)
    if not ball then return nil end
    if ball:IsA("BasePart") then return ball.Position end

    -- Model or Tool: use pivot, that's the true center
    if ball:IsA("Model") or ball:IsA("Tool") then
        local ok, pivot = pcall(function() return ball:GetPivot() end)
        if ok and pivot then return pivot.Position end
        if ball:IsA("Model") and ball.PrimaryPart then
            return ball.PrimaryPart.Position
        end
        if ball:IsA("Tool") then
            local h = ball:FindFirstChild("Handle")
            if h and h:IsA("BasePart") then return h.Position end
        end
    end

    -- Folder or fallback: first BasePart child
    local part = ball:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position end

    return nil
end

local function ballIsHeld(ball)
    if not ball or not ball.Parent then return false end
    local p = ball.Parent
    return p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") ~= nil
end

-- scan ALL footballs, return the closest to our HRP
local function scanForFootball()
    local candidates = {}
    local seen = {}

    local function add(obj)
        if obj and not seen[obj] then
            seen[obj] = true
            candidates[#candidates + 1] = obj
        end
    end

    -- local character
    local myChar = localPlayer.Character
    if myChar then add(myChar:FindFirstChild(FOOTBALL_NAME)) end

    -- other characters
    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local c = p.Character
        if c then add(c:FindFirstChild(FOOTBALL_NAME)) end
    end

    -- workspace direct child
    add(workspace:FindFirstChild(FOOTBALL_NAME))

    -- descendants (folders/models)
    local kids = workspace:GetDescendants()
    for i = 1, #kids do
        local v = kids[i]
        if v.Name == FOOTBALL_NAME then
            add(v)
        end
    end

    if #candidates == 0 then return nil end

    -- pick closest to local HRP
    local myPos = hrp and hrp.Position
    if not myPos then return candidates[1] end

    local best, bestDist = nil, math.huge
    for i = 1, #candidates do
        local c = candidates[i]
        local pos = ballPos(c)
        if pos then
            local d = (pos - myPos).Magnitude
            if d < bestDist then
                bestDist = d
                best = c
            end
        end
    end
    return best or candidates[1]
end

local function findFootball()
    local now = tick()
    if ballCache and ballCache.Parent then
        local held = ballIsHeld(ballCache)
        local win = held and BALL_SCAN_HELD or BALL_SCAN_FREE
        if (now - ballCacheTime) < win then
            return ballCache
        end
    end
    ballCache = scanForFootball()
    ballCacheTime = now
    return ballCache
end

-------------------------------------------------
-- AUTO RUSH HELPERS
-------------------------------------------------
local function pressW()
    if wHeldByRush then return end
    wHeldByRush = true
    if VirtualInput then
        pcall(function()
            VirtualInput:SendKeyEvent(true, Enum.KeyCode.W, false, game)
        end)
    elseif keypress then
        pcall(keypress, 0x57)
    end
end

local function releaseW()
    if not wHeldByRush then return end
    wHeldByRush = false
    if VirtualInput then
        pcall(function()
            VirtualInput:SendKeyEvent(false, Enum.KeyCode.W, false, game)
        end)
    elseif keyrelease then
        pcall(keyrelease, 0x57)
    end
end

local function stopActiveRush()
    autoRushActive = false
    releaseW()
    if humanoid then
        pcall(function() humanoid:Move(Vector3.zero, false) end)
    end
end

local function disableAutoRush()
    autoRushUnlocked = false
    stopActiveRush()
end

local function toggleActiveRush()
    if not autoRushUnlocked then return end
    if autoRushActive then
        stopActiveRush()
        Rayfield:Notify({Title="Auto Rush", Content="Off", Duration=3})
    else
        autoRushActive = true
        Rayfield:Notify({Title="Auto Rush", Content="On — closest Football", Duration=3})
    end
end

-------------------------------------------------
-- HEAD APPLY
-------------------------------------------------
local function captureOrig(head)
    if origSizes[head] then return origSizes[head] end
    local s = head.Size
    origSizes[head] = s
    return s
end

local function desiredSize(head)
    local orig = captureOrig(head)
    if isHeadModEnabled then
        return Vector3.new(targetHeadScale, orig.Y, targetHeadScale)
    end
    return orig
end

local function applyHead(head)
    if not head or not head.Parent then return end
    local targetSize = desiredSize(head)
    if (head.Size - targetSize).Magnitude > SIZE_EPS then
        head.Size = targetSize
    end
end

local function installHeadHooks(head)
    if hooks[head] then return end
    local rec = {}
    rec.sizeConn = head:GetPropertyChangedSignal("Size"):Connect(function()
        if not head.Parent then return end
        local targetSize = desiredSize(head)
        if (head.Size - targetSize).Magnitude > SIZE_EPS then
            head.Size = targetSize
        end
    end)
    hooks[head] = rec
    applyHead(head)
end

-------------------------------------------------
-- HEAD CACHE
-------------------------------------------------
local function bindCharacter(player, char)
    task.spawn(function()
        local head = char:FindFirstChild("Head")
        while not head and char.Parent do
            char.ChildAdded:Wait()
            head = char:FindFirstChild("Head")
        end
        if not head or not char.Parent then return end
        headCache[player] = head
        installHeadHooks(head)
    end)
end

local function hookChar(char)
    humanoid = char:WaitForChild("Humanoid")
    hrp = char:WaitForChild("HumanoidRootPart")

    local animator = humanoid:WaitForChild("Animator")
    animator.AnimationPlayed:Connect(function(track)
        if track.Animation and track.Animation.AnimationId == SIDE_TECH_ANIM_ID then
            sideTechAnimPlaying = true
            if stickyTarget then stickyReleaseInput = true end
            track.Stopped:Once(function() sideTechAnimPlaying = false end)
        end
    end)

    humanoid.Died:Connect(function()
        stickyTarget = nil
        stickyReleaseInput = false
        if humanoid then
            humanoid.PlatformStand = false
            for state, _ in pairs(disabledStates) do
                humanoid:SetStateEnabled(state, true)
            end
            disabledStates = {}
            if savedWalkSpeed then humanoid.WalkSpeed = savedWalkSpeed end
            if savedJumpPower then humanoid.JumpPower = savedJumpPower end
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= localPlayer then
        if p.Character then bindCharacter(p, p.Character) end
        p.CharacterAdded:Connect(function(c) bindCharacter(p, c) end)
    end
end
Players.PlayerAdded:Connect(function(p)
    if p == localPlayer then return end
    if p.Character then bindCharacter(p, p.Character) end
    p.CharacterAdded:Connect(function(c) bindCharacter(p, c) end)
end)
Players.PlayerRemoving:Connect(function(p) headCache[p] = nil end)

if localPlayer.Character then hookChar(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(hookChar)

local rayParam = RaycastParams.new()
rayParam.FilterType = Enum.RaycastFilterType.Exclude

