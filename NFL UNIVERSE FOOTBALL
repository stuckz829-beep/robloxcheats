local function scanBallListOnce()
    local list = {}
    local seen = {}
    local function add(o)
        if o and not seen[o] then seen[o] = true; list[#list + 1] = o end
    end
    local myChar = localPlayer.Character
    if myChar then add(myChar:FindFirstChild(FOOTBALL_NAME)) end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local c = p.Character
        if c then add(c:FindFirstChild(FOOTBALL_NAME)) end
    end
    add(workspace:FindFirstChild(FOOTBALL_NAME))
    if #list == 0 or (refreshCounter % FULL_SCAN_EVERY == 0) then
        local kids = workspace:GetDescendants()
        local limit = #kids
        if limit > FULL_SCAN_LIMIT then limit = FULL_SCAN_LIMIT end
        for i = 1, limit do
            local v = kids[i]
            if v.Name == FOOTBALL_NAME then add(v) end
        end
    end
    refreshCounter = refreshCounter + 1
    ballList = list
    ballListTime = tick()
end

task.spawn(function()
    scanBallListOnce()
    while true do
        task.wait(BALL_LIST_REFRESH)
        scanBallListOnce()
    end
end)

local function findFootball()
    if not hrp then return ballList[1] end
    for i = #ballList, 1, -1 do
        local b = ballList[i]
        if not b or not b.Parent then table.remove(ballList, i) end
    end
    if #ballList == 0 then return nil end
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge
    for i = 1, #ballList do
        local c = ballList[i]
        local pos = ballPos(c)
        if pos then
            local d = (pos - myPos).Magnitude
            if d < bestDist then bestDist = d; best = c end
        end
    end
    return best or ballList[1]
end

