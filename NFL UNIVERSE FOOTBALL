-------------------------------------------------
local function trySwat(reason, ballPosOverride)
    if not autoRushActive then return end
    if not autoRushAllowed() then return end
    if not humanoid or not hrp then return end
    if isFlying or stickyTarget then return end

    local bp = ballPosOverride
    if not bp then
        local ball = findFootball()
        bp = ballPos(ball)
    end
    if not bp then return end

    local d = (bp - hrp.Position).Magnitude
    if d > SWAT_RANGE then return end

    local flat = Vector3.new(bp.X - hrp.Position.X, 0, bp.Z - hrp.Position.Z)
    if flat.Magnitude > 0.5 then
        local vel = hrp.AssemblyLinearVelocity
        hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + flat.Unit)
        hrp.AssemblyLinearVelocity = vel
    end

    pressKey(Enum.KeyCode.Space)
end

