local function updateProxyCollision()
    if not hrp or not humanoid then return end
    if holdingFootball() or autoRushBlocksHeadTech() then
        for i = 1, #cachedPlayers do
            local p = cachedPlayers[i]
            if p ~= localPlayer then
                local pr = headProxies[p]
                if pr and pr.Parent and pr.CanCollide then pr.CanCollide = false end
                local h = headCache[p]
                if h then proxyEngaged[h] = nil end
            end
        end
        return
    end
    local now = tick()
    local jr = (now - lastJumpRequestAt) <= JUMP_ATTACH_WINDOW
    for i = 1, #cachedPlayers do
        local p = cachedPlayers[i]
        if p ~= localPlayer then
            local pr = headProxies[p]
            local h = headCache[p]
            if pr and pr.Parent and h and h.Parent then
                pr.Size = h.Size
                pr.CFrame = h.CFrame
                local eng = proxyEngaged[h] == true
                local tight = feetOverHead(h, PROXY_FOOTPRINT_PAD, PROXY_FEET_ABOVE_TOLERANCE)
                local loose = feetOverHead(h, PROXY_ENGAGED_PAD, PROXY_FEET_ABOVE_TOLERANCE)
                local solid = false
                if eng then
                    if loose then solid = true else proxyEngaged[h] = nil end
                else
                    if tight and jr then proxyEngaged[h] = true; solid = true end
                end
                if pr.CanCollide ~= solid then pr.CanCollide = solid end
            end
        end
    end
end
