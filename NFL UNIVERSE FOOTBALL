local function rushTargetPos()
    local c = getBallCarrier()
    if not c then
        if lastRushCarrier ~= nil then lastRushCarrier = nil; rushEngageStartAt = 0 end
        return ballPos(findFootball and findFootball())
    end
    if c ~= lastRushCarrier or rushEngageStartAt == 0 then
        lastRushCarrier = c
        rushEngageStartAt = tick()
    end
    local th = c:FindFirstChild("HumanoidRootPart")
    if not th then return ballPos(findFootball and findFootball()) end
    local tp = th.Position
    if not hrp then return tp + QB_CHEST_OFFSET end
    local chest = tp + QB_CHEST_OFFSET
    local mp = hrp.Position
    local v = th.AssemblyLinearVelocity
    local fv = Vector3.new(v.X, 0, v.Z)
    local sp = fv.Magnitude
    if sp < 1.0 then return chest end
    local hd = fv / sp
    local toHim = Vector3.new(tp.X - mp.X, 0, tp.Z - mp.Z)
    local dist = toHim.Magnitude
    if dist < 0.01 then return chest end
    local ms = walkSpeed
    if ms < 1 then ms = 1 end
    local a = sp*sp - ms*ms
    local b = 2*toHim:Dot(fv)
    local cc = dist*dist
    local ti
    if math.abs(a) < 1e-4 then
        if math.abs(b) > 1e-4 then local t = -cc / b; if t > 0 then ti = t end end
    else
        local disc = b*b - 4*a*cc
        if disc >= 0 then
            local sq = math.sqrt(disc)
            local t1 = (-b + sq) / (2*a)
            local t2 = (-b - sq) / (2*a)
            if t1 > 0 and (not ti or t1 < ti) then ti = t1 end
            if t2 > 0 and (not ti or t2 < ti) then ti = t2 end
        end
    end
    if not ti or ti <= 0 then ti = 0.6 end
    ti = math.clamp(ti, RUSH_T_MIN, RUSH_T_MAX)
    local aim = chest + fv * (ti * RUSH_OVERSHOOT)
    local fwd = (aim - tp):Dot(hd)
    if fwd < RUSH_FORWARD_MIN then aim = aim + hd * (RUSH_FORWARD_MIN - fwd) end
    local av = aim - tp
    local al = av.Magnitude
    if al > dist then aim = tp + av.Unit * dist end
    return aim
end
