local function studsToVelocity(studs)
    local g = workspace.Gravity
    if g <= 0 then g = 196.2 end
    return math.sqrt(2 * g * math.max(0, studs))
end

-- smoothstep: zero derivative at both ends. clean ease-in and ease-out.
local function smoothstep(t)
    if t <= 0 then return 0 end
    if t >= 1 then return 1 end
    return t * t * (3 - 2 * t)
end

