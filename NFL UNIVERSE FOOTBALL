UIS.InputBegan:Connect(function(i, gp)
    if not gp and i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode == AUTO_RUSH_KEY then
        toggleActiveRush()
        return
    end

    if i.UserInputType == Enum.UserInputType.MouseButton1 and not gp then
        isHoldingM1 = true
        if autoSideTechEnabled and not isShiftLocked() then
            local camLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
            sideTechTargetLookVector = Vector3.new(-camLook.Z, 0, camLook.X)
            isHoldingSideTech = true
        end
    end

    if stickyTarget then
        if i.KeyCode == Enum.KeyCode.W or i.KeyCode == Enum.KeyCode.A
        or i.KeyCode == Enum.KeyCode.S or i.KeyCode == Enum.KeyCode.D
        or i.KeyCode == Enum.KeyCode.Space then
            stickyReleaseInput = true
        end
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        isHoldingM1 = false
        isHoldingSideTech = false
        sideTechTargetLookVector = nil
    end
end)

-------------------------------------------------
-- STICKY HEAD HELPERS
-------------------------------------------------
local function headBottomY(head)
    return head.Position.Y - head.Size.Y * 0.5
end

local function headRangeFor(head)
    if not isHeadModEnabled then return STICKY_RANGE_BASE end
    if head.Size.X >= HEAD_SIZE_THRESHOLD then return STICKY_RANGE_EXTENDED end
    return STICKY_RANGE_BASE
end

local function findNearestHead()
    if not hrp then return nil end
    local bestHead, bestDist = nil, math.huge
    local hrpY = hrp.Position.Y
    local hrpPos = hrp.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local head = headCache[p]
        if not head or not head.Parent then continue end

        if headBottomY(head) > hrpY + ATTACH_HEAD_ABOVE_MARGIN then continue end

        local d = (head.Position - hrpPos).Magnitude
        local range = headRangeFor(head)
        if d <= range and d < bestDist then
            bestDist = d
            bestHead = head
        end
    end
    return bestHead
end

local function headTopOffset(head)
    local hipHeight = humanoid.HipHeight or 2.0
    return Vector3.new(0, head.Size.Y * 0.5 + hipHeight + FOOT_CLEARANCE, 0)
end

local function silenceHumanoid()
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end
    for _, state in ipairs({
        Enum.HumanoidStateType.Freefall,
        Enum.HumanoidStateType.Jumping,
        Enum.HumanoidStateType.FallingDown,
        Enum.HumanoidStateType.Ragdoll,
        Enum.HumanoidStateType.PlatformStanding,
    }) do
        if humanoid:GetStateEnabled(state) then
            humanoid:SetStateEnabled(state, false)
            disabledStates[state] = true
        end
    end
    if savedWalkSpeed == nil then savedWalkSpeed = humanoid.WalkSpeed end
    if savedJumpPower == nil then savedJumpPower = humanoid.JumpPower end
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.JumpHeight = 0
    humanoid.PlatformStand = true
    humanoid:ChangeState(Enum.HumanoidStateType.Running)
end

local function unsilenceHumanoid()
    if not humanoid then return end
    for state, _ in pairs(disabledStates) do
        humanoid:SetStateEnabled(state, true)
    end
    disabledStates = {}
    if savedWalkSpeed ~= nil then
        humanoid.WalkSpeed = savedWalkSpeed
        savedWalkSpeed = nil
    end
    if savedJumpPower ~= nil then
        humanoid.JumpPower = savedJumpPower
        savedJumpPower = nil
    end
    humanoid.PlatformStand = false
end

local function attachSticky(head)
    stickyTarget = head
    stickyReleaseInput = false
    attachTime = tick()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    silenceHumanoid()
end

local function detachSticky()
    local prevHead = stickyTarget

    stickyTarget = nil
    stickyReleaseInput = false
    stickyCooldown = REATTACH_COOLDOWN
    attachTime = 0

    unsilenceHumanoid()
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    if prevHead and prevHead.Parent then
        prevHead.CanCollide = true
    end
end

-------------------------------------------------
-- HEAD EXTENDER: collision only
-------------------------------------------------
local function runHeadLoop()
    if not hrp or not humanoid then return end

    rayParam.FilterDescendantsInstances = {localPlayer.Character}
    local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -STAND_RAY_LENGTH, 0), rayParam)
    local standingOn = ray and ray.Instance

    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local head = headCache[p]
        if not head or not head.Parent then continue end

        local standingOnThisHead = (standingOn == head)
        if sideTechAnimPlaying or isHoldingSideTech then
            if head.CanCollide then head.CanCollide = false end
        elseif standingOnThisHead then
            if not head.CanCollide then head.CanCollide = true end
        else
            if head.CanCollide then head.CanCollide = false end
        end
    end
end

-------------------------------------------------
-- HEARTBEAT
-------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
    if not hrp or not humanoid then return end

    if workspace.Gravity ~= gravityVal then workspace.Gravity = gravityVal end
    if stickyCooldown > 0 then stickyCooldown = math.max(0, stickyCooldown - dt) end

    -- Side Tech
    if isHoldingSideTech and sideTechTargetLookVector and not isShiftLocked() and not sideTechAnimPlaying then
        local vel = hrp.AssemblyLinearVelocity
        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + sideTechTargetLookVector)
        hrp.AssemblyLinearVelocity = vel
    end

    -- Dive Boost
    if diveBoostEnabled and diveBoostSpeed > 0 and not isFlying and not stickyTarget then
        if sideTechAnimPlaying and not prevDiveState then
            local dir = diveDirection()
            local base = hrp.AssemblyLinearVelocity
            local horiz = Vector3.new(base.X, 0, base.Z)
            hrp.AssemblyLinearVelocity = horiz + dir * diveBoostSpeed + Vector3.new(0, base.Y, 0)
        end
    end
    prevDiveState = sideTechAnimPlaying

    -- Pull Vector
    if pullVectorEnabled and isHoldingM1 and not isFlying and not stickyTarget then
        local ball = findFootball()
        local bp = ballPos(ball)
        if bp then
            local direction = bp - hrp.Position
            local currentDistance = direction.Magnitude
            if currentDistance <= 4.5 then
                hrp.AssemblyLinearVelocity = Vector3.zero
            elseif currentDistance > 2 then
                hrp.AssemblyLinearVelocity = direction.Unit * pullSpeed
            end
        end
    end

    -- Auto Rush
    if autoRushUnlocked and autoRushActive and not isFlying and not stickyTarget then
        local ball = findFootball()
        local bp = ballPos(ball)
        if bp then
            local diff = bp - hrp.Position
            local flat = Vector3.new(diff.X, 0, diff.Z)
            local flatMag = flat.Magnitude
            if flatMag > 0.5 then
                local dir = flat / flatMag

                if CHASE_ORIENT then
                    local vel = hrp.AssemblyLinearVelocity
                    hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir)
                    hrp.AssemblyLinearVelocity = vel
                end

                pcall(function() humanoid:Move(dir, false) end)
            else
                pcall(function() humanoid:Move(Vector3.zero, false) end)
            end
        end
        pressW()
    elseif autoRushActive and (isFlying or stickyTarget) then
        stopActiveRush()
    elseif not autoRushActive and wHeldByRush then
        releaseW()
    end

    -- Flight
    if isFlying then
        if stickyTarget then detachSticky() end
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        local move = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then move += camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += camera.CFrame.RightVector end
        flyVelocity = (move.Magnitude > 0) and flyVelocity:Lerp(move.Unit * flySpeed, flyAccel * dt) or flyVelocity:Lerp(Vector3.zero, flyFriction * dt)
        hrp.AssemblyLinearVelocity = flyVelocity
    end

    -- STICKY HEAD
    if stickyHeadEnabled and not isFlying then
        if stickyTarget then
            local parentChar = stickyTarget.Parent
            local stillAlive = parentChar and parentChar.Parent == workspace
            if stickyReleaseInput or anyMoveKeyDown() or not stillAlive then
                detachSticky()
            end
        end

        if not stickyTarget and stickyCooldown <= 0 and not anyMoveKeyDown() and isAirborne() then
            local head = findNearestHead()
            if head then attachSticky(head) end
        end

        if stickyTarget then
            local offset = headTopOffset(stickyTarget)
            local desired = stickyTarget.CFrame * CFrame.new(offset)

            local elapsed = tick() - attachTime
            local lerpAlpha
            if elapsed < EASE_DURATION then
                local t = elapsed / EASE_DURATION
                lerpAlpha = EASE_LERP + (SMOOTH_LERP - EASE_LERP) * t
            else
                lerpAlpha = SMOOTH_LERP
            end

            local newPos = hrp.Position:Lerp(desired.Position, lerpAlpha)

            if elapsed >= EASE_DURATION and (newPos - desired.Position).Magnitude < SNAP_THRESHOLD then
                newPos = desired.Position
            end

            hrp.CFrame = CFrame.new(newPos, newPos + stickyTarget.CFrame.LookVector)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            if not humanoid.PlatformStand then humanoid.PlatformStand = true end
            if humanoid.WalkSpeed ~= 0 then humanoid.WalkSpeed = 0 end

            local animator = humanoid:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    local id = track.Animation and track.Animation.AnimationId
                    if id and id ~= SIDE_TECH_ANIM_ID then
                        track:Stop(0)
                    end
                end
            end
        end
    elseif stickyTarget and not stickyHeadEnabled then
        detachSticky()
    end

    local now = tick()
    if now - lastHeadLoop >= HEAD_LOOP_INTERVAL then
        lastHeadLoop = now
        runHeadLoop()
    end
end)

