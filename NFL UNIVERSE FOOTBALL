local hasFileApi = (type(writefile) == "function" and type(readfile) == "function")
local CONFIG_PATH = "UltimateFootballHub_auto.json"

local function readAutoConfig()
    if not hasFileApi then return nil end
    if type(isfile) == "function" and not isfile(CONFIG_PATH) then return nil end
    local ok, contents = pcall(function() return readfile(CONFIG_PATH) end)
    if not ok or not contents or contents == "" then return nil end
    local dok, decoded = pcall(function() return HttpService:JSONDecode(contents) end)
    if not dok then return nil end
    return decoded
end

local function writeAutoConfig(data)
    if not hasFileApi then return false end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then return false end
    return pcall(function() writefile(CONFIG_PATH, encoded) end)
end

local function deleteAutoConfig()
    if type(delfile) == "function" then
        pcall(function() delfile(CONFIG_PATH) end)
    elseif hasFileApi then
        pcall(function() writefile(CONFIG_PATH, "{}") end)
    end
end

