-- Ultimate Football Hub 2026 (Modified: Jump-Delayed Head + Proximity Magnet)
getgenv().SecureMode = true

-------------------------------------------------
-- LOAD RAYFIELD
-------------------------------------------------
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

-------------------------------------------------
-- SERVICES
-------------------------------------------------
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

-------------------------------------------------
-- VARIABLES
-------------------------------------------------
local isNoclipEnabled = false
local isFlying = false
local flySpeed = 50
local flyVelocity = Vector3.zero
local flyAccel, flyFriction = 8, 6
local walkSpeed = 18
local gravityVal = 196.2

-- Side Tech
local autoSideTechEnabled = false
local isHoldingSideTech = false
local sideTechTargetLookVector = nil
local SIDE_TECH_ANIM_ID = "rbxassetid://8839176574"
local sideTechAnimPlaying = false

-- Head Mod (Modified Logic)
local isHeadModEnabled = false
local targetHeadScale = 5
local lastJumpTime = 0

-- Magnet (Modified Logic)
local isMagEnabled = false
local magRange = 0.15
local magActivationDistance = 20 -- Ball must be within this range
local isPulling = false

-- Auto Rusher / Tackle
local isAutoRusherEnabled = false
local autoRusherKey = Enum.KeyCode.G
local rusherHolding = false
local tackleReachEnabled = false
local tackleReachSize = Vector3.new(8,6,8)
local tackleHitboxes = {}

local humanoid, hrp
local currentBall
local cachedPlayers = {}

-------------------------------------------------
-- UTILITIES
-------------------------------------------------
local function rebuildPlayerCache()
    table.clear(cachedPlayers)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer then table.insert(cachedPlayers, p) end
    end
end
Players.PlayerAdded:Connect(rebuildPlayerCache)
Players.PlayerRemoving:Connect(rebuildPlayerCache)
rebuildPlayerCache()

task.spawn(function()
    while task.wait(0.5) do
        currentBall = workspace:FindFirstChild("Football", true) or workspace:FindFirstChild("Ball", true)
    end
end)

-------------------------------------------------
-- CHARACTER & JUMP TRACKING
-------------------------------------------------
local function hookChar(char)
    humanoid = char:WaitForChild("Humanoid")
    hrp = char:WaitForChild("HumanoidRootPart")
    humanoid.WalkSpeed = walkSpeed

    humanoid.Jumping:Connect(function()
        lastJumpTime = tick()
    end)

    local animator = humanoid:WaitForChild("Animator")
    animator.AnimationPlayed:Connect(function(track)
        if track.Animation and track.Animation.AnimationId == SIDE_TECH_ANIM_ID then
            sideTechAnimPlaying = true
            track.Stopped:Once(function() sideTechAnimPlaying = false end)
        end
    end)
end
if localPlayer.Character then hookChar(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(hookChar)

-------------------------------------------------
-- HEAD LOGIC (DELAYED & PERSISTENT)
-------------------------------------------------
local function updateHeadVisuals()
    local timeSinceJump = tick() - lastJumpTime
    local shouldShowBigHead = isHeadModEnabled and (timeSinceJump >= 0.15)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == localPlayer then continue end
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        if not head then continue end

        if not head:FindFirstChild("OriginalSize") then
            local v = Instance.new("Vector3Value", head)
            v.Name = "OriginalSize"
            v.Value = head.Size
        end

        if shouldShowBigHead then
            head.Size = Vector3.new(targetHeadScale, head.OriginalSize.Value.Y, targetHeadScale)
            head.Transparency = 0.5
        else
            head.Size = head.OriginalSize.Value
            head.Transparency = 0
        end

        -- Persistent Collision Detection
        local rayParam = RaycastParams.new()
        rayParam.FilterDescendantsInstances = {char}
        rayParam.FilterType = Enum.RaycastFilterType.Exclude
        local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -5, 0), rayParam)
        
        -- If standing on head, keep collision regardless of jump timer
        if ray and ray.Instance == head then
            head.CanCollide = true
        else
            head.CanCollide = shouldShowBigHead
        end
    end
end

-------------------------------------------------
-- TACKLE SYSTEM
-------------------------------------------------
local function updateTackleHitboxes()
    if not tackleReachEnabled or not currentBall or not hrp then return end
    for _, p in ipairs(cachedPlayers) do
        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and currentBall.Parent == char then
            if not tackleHitboxes[p] then
                local hb = Instance.new("Part", workspace)
                hb.Shape, hb.Size, hb.Anchored, hb.CanCollide = Enum.PartType.Ball, tackleReachSize, true, false
                hb.Transparency, hb.Material, hb.Color = 0.5, Enum.Material.Neon, Color3.fromRGB(255,0,0)
                tackleHitboxes[p] = hb
            end
            tackleHitboxes[p].CFrame = root.CFrame
        elseif tackleHitboxes[p] then
            tackleHitboxes[p]:Destroy()
            tackleHitboxes[p] = nil
        end
    end
end

-------------------------------------------------
-- INPUT HANDLERS
-------------------------------------------------
UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        isPulling = true
        if autoSideTechEnabled and UIS.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
            local camLook = Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z).Unit
            sideTechTargetLookVector = Vector3.new(-camLook.Z,0,camLook.X)
            isHoldingSideTech = true
        end
    elseif i.KeyCode == autoRusherKey then
        rusherHolding = true
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        isPulling = false
        isHoldingSideTech = false
    elseif i.KeyCode == autoRusherKey then
        rusherHolding = false
    end
end)

-------------------------------------------------
-- MAIN LOOP
-------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
    if not humanoid or not hrp then return end

    -- Magnet with Distance Check (20 studs)
    if isMagEnabled and isPulling and currentBall then
        local dist = (hrp.Position - currentBall.Position).Magnitude
        if dist <= magActivationDistance and not currentBall.Parent:FindFirstChildOfClass("Humanoid") then
            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(currentBall.Position), magRange * 0.02)
        end
    end

    -- Side Tech
    if isHoldingSideTech and sideTechTargetLookVector and not sideTechAnimPlaying then
        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + sideTechTargetLookVector)
    end

    -- Flight
    if isFlying then
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        local move = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then move += camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += camera.CFrame.RightVector end
        flyVelocity = (move.Magnitude > 0) and flyVelocity:Lerp(move.Unit * flySpeed, flyAccel * dt) or flyVelocity:Lerp(Vector3.zero, flyFriction * dt)
        hrp.AssemblyLinearVelocity = flyVelocity
    end

    updateHeadVisuals()
    updateTackleHitboxes()
end)

-------------------------------------------------
-- UI SETUP
-------------------------------------------------
local Window = Rayfield:CreateWindow({
    Name = "Ultimate Football Hub 2026",
    LoadingTitle = "Pro Systems Loaded",
    ConfigurationSaving = { Enabled = true }
})

local MainTab = Window:CreateTab("Combat/Physics")
local MagTab = Window:CreateTab("Magnet")

MainTab:CreateToggle({Name="Enable Delayed Head Size", Callback=function(v) isHeadModEnabled=v end})
MainTab:CreateSlider({Name="Head Size", Range={1,15}, Increment=0.5, CurrentValue=5, Callback=function(v) targetHeadScale=v end})
MainTab:CreateToggle({Name="Auto Side Tech (HOLD)", Callback=function(v) autoSideTechEnabled=v end})
MainTab:CreateToggle({Name="Noclip", Callback=function(v) isNoclipEnabled=v end})

MagTab:CreateToggle({Name="Enable Smart Magnet", Callback=function(v) isMagEnabled=v end})
MagTab:CreateSlider({Name="Max Pull Distance", Range={5,100}, Increment=1, CurrentValue=20, Callback=function(v) magActivationDistance=v end})
MagTab:CreateSlider({Name="Pull Strength", Range={0.05,1}, Increment=0.05, CurrentValue=0.15, Callback=function(v) magRange=v end})

Rayfield:Notify({Title="Loaded", Content="Jump-Delay Head & Proximity Magnet Active", Duration=5})
