    if type(data.targetHeadScale) == "number" then targetHeadScale = data.targetHeadScale; sS("targetHeadScale", data.targetHeadScale) end
    if type(data.autoSideTechEnabled) == "boolean" then autoSideTechEnabled = data.autoSideTechEnabled; sT("autoSideTechEnabled", data.autoSideTechEnabled) end
    if type(data.diveBoostEnabled) == "boolean" then diveBoostEnabled = data.diveBoostEnabled; sT("diveBoostEnabled", data.diveBoostEnabled) end
    if type(data.diveBoostLevel) == "number" then diveBoostLevel = data.diveBoostLevel; recomputeDiveBoost(); sS("diveBoostLevel", data.diveBoostLevel) end
