-- HEAD SIZE / TRANSPARENCY / PROXIES
-------------------------------------------------
local function readOrigFromAttr(part)
    local ok, v = pcall(function() return part:GetAttribute(ORIG_SIZE_ATTR) end)
    if not ok or not v or typeof(v) ~= "Vector3" then return nil end
    return v
end
local function writeOrigToAttr(part, size)
    pcall(function() part:SetAttribute(ORIG_SIZE_ATTR, size) end)
end
local function captureOrig(part)
    if origSizes[part] then return origSizes[part] end
    local persisted = readOrigFromAttr(part)
    if persisted then origSizes[part] = persisted; return persisted end
    local s = part.Size
    origSizes[part] = s
    writeOrigToAttr(part, s)
    return s
end
local function applyHeadNow(head)
    if not head or not head.Parent then return end
    local orig = captureOrig(head)
    local targetSize = isHeadModEnabled and Vector3.new(targetHeadScale, orig.Y, targetHeadScale) or orig
    pcall(function()
        if (head.Size - targetSize).Magnitude > SIZE_EPS then head.Size = targetSize end
    end)
    if origCanCollide[head] == nil then origCanCollide[head] = head.CanCollide end
    if head.CanCollide then pcall(function() head.CanCollide = false end) end
end
local function applyToAllHeads()
    for i = 1, #cachedPlayers do
        local p = cachedPlayers[i]
        if p ~= localPlayer then
            local c = p.Character
            local h = c and c:FindFirstChild("Head")
            if h then headCache[p] = h; applyHeadNow(h) end
        end
    end
end

local function desiredHeadTransparency()
    if headsInvisibleEnabled then return 1 end
    if isHeadModEnabled then return HEAD_EXTENDER_TRANSPARENCY end
    return nil
end
local function applyHeadTransparency(head)
    if not head or not head.Parent then return end
    local want = desiredHeadTransparency()
    if want == nil then
        local t = origTransparency[head]
        if t ~= nil then pcall(function() head.Transparency = t end) end
        return
    end
    if origTransparency[head] == nil then origTransparency[head] = head.Transparency end
    if head.Transparency ~= want then pcall(function() head.Transparency = want end) end
end
local function applyTransparencyToAllHeads()
    for i = 1, #cachedPlayers do
        local p = cachedPlayers[i]
        if p ~= localPlayer then
            local head = headCache[p]
            if head and head.Parent then applyHeadTransparency(head) end
        end
    end
end

local function resolveLiveHead(player)
    local char = player.Character
    if not char or not char.Parent then return nil end
    return char:FindFirstChild("Head")
end
local function enforceHeadFor(player)
    if not player or player == localPlayer then return end
    local head = resolveLiveHead(player)
    if not head then return end
    if headCache[player] ~= head then headCache[player] = head end
    if isHeadModEnabled then applyHeadNow(head) end
    applyHeadTransparency(head)
end
local function enforceHeadsNow()
    for i = 1, #cachedPlayers do enforceHeadFor(cachedPlayers[i]) end
end

local function destroyHeadProxy(player)
    local proxy = headProxies[player]
    if proxy then pcall(function() proxy:Destroy() end); headProxies[player] = nil end
end
local function destroyAllHeadProxies()
    for p, _ in pairs(headProxies) do destroyHeadProxy(p) end
end
local function ensureHeadProxy(player, head)
    if not head or not head.Parent then destroyHeadProxy(player); return end
    if not (isHeadModEnabled or stickyHeadEnabled) then destroyHeadProxy(player); return end
    local proxy = headProxies[player]
    if not proxy or not proxy.Parent then
        proxy = Instance.new("Part")
        proxy.Name = "UFH_HeadProxy"
        proxy.Transparency = 1
        proxy.Anchored = true
        proxy.CanCollide = false
        proxy.CanQuery = false
        proxy.CanTouch = false
        proxy.Massless = true
        proxy.Locked = true
        proxy.CastShadow = false
        proxy.TopSurface = Enum.SurfaceType.Smooth
        proxy.BottomSurface = Enum.SurfaceType.Smooth
        proxy.Parent = workspace
        headProxies[player] = proxy
    end
    proxy.Size = head.Size
    proxy.CFrame = head.CFrame
end

