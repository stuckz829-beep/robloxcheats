-------------------------------------------------
local function lockActive() return walkSpeed >= WALKSPEED_LOCK_THRESHOLD end
local function autoRushAllowed() return walkSpeed >= WALKSPEED_LOCK_THRESHOLD end
local function autoRushBlocksHeadTech() return autoRushActive == true end

local function isRagdolled()
    if not humanoid then return false end
    if humanoid.PlatformStand then return true end
    local st = humanoid:GetState()
    return st == Enum.HumanoidStateType.Ragdoll
        or st == Enum.HumanoidStateType.Physics
        or st == Enum.HumanoidStateType.FallingDown
end

local function enforceWalkSpeed()
    if not humanoid or walkSpeedLockSuspended or not lockActive() then return end
    if humanoid.WalkSpeed ~= walkSpeed then humanoid.WalkSpeed = walkSpeed end
end

local function installWalkSpeedLock(hum)
    if walkSpeedConn then pcall(function() walkSpeedConn:Disconnect() end); walkSpeedConn = nil end
    if not hum then return end
    walkSpeedConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if not alive or walkSpeedLockSuspended or not lockActive() then return end
        if humanoid and humanoid.WalkSpeed ~= walkSpeed then humanoid.WalkSpeed = walkSpeed end
    end)
end

local wallRayParams = nil
local function wallAhead(dir, dist)
    if not hrp then return false end
    local flat = Vector3.new(dir.X, 0, dir.Z)
    if flat.Magnitude < 0.05 then return false end
    flat = flat.Unit
    if not wallRayParams then
        wallRayParams = RaycastParams.new()
        wallRayParams.FilterType = Enum.RaycastFilterType.Exclude
        wallRayParams.IgnoreWater = true
    end
    local ignore = {}
    local myChar = localPlayer.Character
    if myChar then
        for _, d in ipairs(myChar:GetDescendants()) do
            if d:IsA("BasePart") then ignore[#ignore+1] = d end
        end
    end
    wallRayParams.FilterDescendantsInstances = ignore
    local hit = workspace:Raycast(hrp.Position, flat * dist, wallRayParams)
    return hit ~= nil
end

local function applyNoclip()
    if not noclipEnabled then return end
    local now = tick()
    if now < noclipNextAt then return end
    noclipNextAt = now + NOCLIP_INTERVAL
    local char = localPlayer.Character
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.CanCollide then
            pcall(function() d.CanCollide = false end)
        end
    end
end

local function clampHorizontalSpeed()
    if not lockActive() or walkSpeedLockSuspended then return end
    if not hrp or not humanoid then return end
    if isFlying or stickyTarget or sideTechAnimPlaying or isRagdolled() then return end
    if autoRushActive then return end
    local md = humanoid.MoveDirection
    local mdFlat = Vector3.new(md.X, 0, md.Z)
    if mdFlat.Magnitude < 0.05 then return end
    local vel = hrp.AssemblyLinearVelocity
    local flat = Vector3.new(vel.X, 0, vel.Z)
    local flatMag = flat.Magnitude
    if flatMag >= walkSpeed then return end
    local dir = mdFlat.Unit
    if flatMag > 0.5 then
        local velDir = flat / flatMag
        if velDir:Dot(dir) >= 0.3 then dir = velDir end
    end
    if wallAhead(dir, 2.0) then return end
    hrp.AssemblyLinearVelocity = Vector3.new(dir.X * walkSpeed, vel.Y, dir.Z * walkSpeed)
end

