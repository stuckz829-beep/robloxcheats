local function isNearHead(head)
    if not hrp or not head or not head.Parent then return false end
    local myPos = hrp.Position
    local hp = head.Position
    local dxz = Vector3.new(hp.X - myPos.X, 0, hp.Z - myPos.Z).Magnitude
    local dy = math.abs(hp.Y - myPos.Y)
    return dxz <= JUMP_BOOST_HORIZ_RANGE and dy <= JUMP_BOOST_VERT_RANGE
end

local function applyJumpBoost(fromHead)
    if not jumpBoostEnabled then return end
    if not hrp or not humanoid then return end
    if jumpBoostStuds <= 0 then return end
    if isFlying then return end

    if stickyTarget then detachSticky() end

    local v = studsToVelocity(jumpBoostStuds)
    local vel = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = Vector3.new(vel.X, v, vel.Z)
    lastJumpTime = tick()
end

local function watchPlayerJumps(player)
    if targetJumpConns[player] then return end
    local rec = {}
    local function bindHumanoid(hum)
        if not hum then return end
        if rec.humConn then pcall(function() rec.humConn:Disconnect() end) end
        rec.humConn = hum.Jumping:Connect(function()
            if not jumpBoostEnabled then return end
            if player == localPlayer then return end
            local head = headCache[player]
            if not head or not head.Parent then return end
            if isNearHead(head) then applyJumpBoost(head) end
        end)
    end
    if player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then bindHumanoid(hum) end
    end
    rec.charConn = player.CharacterAdded:Connect(function(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then bindHumanoid(hum) end
    end)
    targetJumpConns[player] = rec
end

local function unwatchPlayerJumps(player)
    local rec = targetJumpConns[player]
    if rec then
        if rec.humConn then pcall(function() rec.humConn:Disconnect() end) end
        if rec.charConn then pcall(function() rec.charConn:Disconnect() end) end
        targetJumpConns[player] = nil
    end
end

