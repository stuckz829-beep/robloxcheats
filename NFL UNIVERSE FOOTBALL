local function targetHeadDiving(head)
    if not head or not head.Parent then return false end
    local char = head.Parent
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local now = tick()
    local nextAt = targetDivingRefresh[hum] or 0
    if now >= nextAt then
        targetDivingRefresh[hum] = now + 0.15
        targetDivingCache[hum] = characterIsDiving(char)
    end
    return targetDivingCache[hum] == true
end

local function targetIsMovingNormally(char)
    if not char then return false end
    if targetHasFootball(char) then return false end
    if characterIsDiving(char) then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local s = hum:GetState()
    return OK_TARGET_STATES[s] == true
end

