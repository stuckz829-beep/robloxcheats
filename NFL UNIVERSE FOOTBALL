local function headRangeFor(head)
    if isHeadModEnabled then return STICKY_RANGE_EXTENDED end
    if head.Size.X >= HEAD_SIZE_THRESHOLD then return STICKY_RANGE_EXTENDED end
    return STICKY_RANGE_BASE
end

local function findNearestHead()
    if not hrp then return nil end
    local myVel = hrp.AssemblyLinearVelocity
    if myVel.Y > STICK_MAX_RISE_VELOCITY then return nil end
    local hipHeight = humanoid and humanoid.HipHeight or 2.0
    local hrpY = hrp.Position.Y
    local feetY = hrpY - hipHeight
    local hrpPos = hrp.Position
    local bestHead, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local head = headCache[p]
        if not head or not head.Parent then continue end
        local headTop = head.Position.Y + head.Size.Y * 0.5
        local headBottom = head.Position.Y - head.Size.Y * 0.5
        if headTop > feetY + STICK_MAX_HEADTOP_BELOW_FEET then continue end
        if headBottom > feetY + 0.5 then continue end
        local d = (head.Position - hrpPos).Magnitude
        local range = headRangeFor(head)
        if d <= range and d < bestDist then bestDist = d; bestHead = head end
    end
    return bestHead
end

local function headTopOffset(head)
    local hipHeight = humanoid.HipHeight or 2.0
    return Vector3.new(0, head.Size.Y * 0.5 + hipHeight + FOOT_CLEARANCE, 0)
end

-------------------------------------------------
-- HEAD SOLID
-------------------------------------------------
local function runHeadLoop()
    if not hrp or not humanoid then return end

    local now = tick()
    local airborne = isAirborne()
    local inDive = sideTechAnimPlaying or isHoldingSideTech
    local stuck = stickyTarget ~= nil
    local hrpY = hrp.Position.Y
    local hrpPos = hrp.Position
    local jumpJustHappened = (now - lastJumpTime) < JUMP_COLLISION_DELAY

    local candidates = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local head = headCache[p]
        if not head or not head.Parent then
            headSolid[head] = nil
            continue
        end

        if targetHeadDiving(head) then
            if headSolid[head] then
                headSolid[head] = nil
                headSolidCooldownUntil[head] = now + SOLID_HYSTERESIS
            end
            if head.CanCollide then head.CanCollide = false end
            continue
        end

        local headHalfX = head.Size.X * 0.5 + HEAD_FOOTPRINT_PAD
        local headHalfZ = head.Size.Z * 0.5 + HEAD_FOOTPRINT_PAD
        local dx = math.abs(head.Position.X - hrpPos.X)
        local dz = math.abs(head.Position.Z - hrpPos.Z)
        local overHead = (dx <= headHalfX) and (dz <= headHalfZ)
        local dxz = math.sqrt(dx * dx + dz * dz)

        local headTop = head.Position.Y + head.Size.Y * 0.5
        local headIsBelow = (headTop < hrpY - LAND_MIN_ABOVE)

        local isStillSolid = headSolid[head] == true
        local canBecomeSolid = not isStillSolid and (headSolidCooldownUntil[head] or 0) <= now

        local ok = headIsBelow
            and not inDive
            and not stuck
            and not justHappened
            and airborne
            and overHead

        if ok and (isStillSolid or canBecomeSolid) then
            candidates[#candidates + 1] = {head = head, dist = dxz}
        end
    end

    table.sort(candidates, function(a, b) return a.dist < b.dist end)

    local solidSet = {}
    for i = 1, math.min(MAX_SOLID_HEADS, #candidates) do
        solidSet[candidates[i].head] = true
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local head = headCache[p]
        if not head or not head.Parent then continue end
        local shouldBeSolid = solidSet[head] == true
        if shouldBeSolid then
            if not headSolid[head] then headSolidSince[head] = now end
            headSolid[head] = true
            if not head.CanCollide then head.CanCollide = true end
        else
            if headSolid[head] then headSolidCooldownUntil[head] = now + SOLID_HYSTERESIS end
            headSolid[head] = nil
            if head.CanCollide then head.CanCollide = false end
        end
    end
end

