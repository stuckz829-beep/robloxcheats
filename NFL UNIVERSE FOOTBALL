-------------------------------------------------
-- MAIN HEARTBEAT
-------------------------------------------------
track(RunService.Heartbeat:Connect(function(dt)
    if not alive then return end
    if not hrp or not humanoid then return end
    if refreshPinning then return end

    if workspace.Gravity ~= gravityVal then workspace.Gravity = gravityVal end
    if stickyCooldown > 0 then stickyCooldown = math.max(0, stickyCooldown - dt) end

    local now = tick()

    enforceWalkSpeed()
    isStandingOnHead()

    if autoRushActive and not autoRushAllowed() then
        stopActiveRush()
        Rayfield:Notify({Title="Auto Rush", Content="Off (WalkSpeed < 22)", Duration=3})
    end

    if autoRushActive then
        getBallCarrier()
    end

    if lastMyPos then
        local jumped = (hrp.Position - lastMyPos).Magnitude > TELEPORT_THRESHOLD
        if jumped then
            if stickyTarget then detachSticky() end
            for k in pairs(headSolid) do headSolid[k] = nil end
            for k in pairs(headWasOverhead) do headWasOverhead[k] = nil end
            lastHeadContactAt = 0
        end
    end
    lastMyPos = hrp.Position

    if isHoldingSideTech and sideTechTargetLookVector
       and not isShiftLocked()
       and not sideTechAnimPlaying then
        local vel = hrp.AssemblyLinearVelocity
        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + sideTechTargetLookVector)
        hrp.AssemblyLinearVelocity = vel
    end

    -- DIVE ENTRY: vector sum. Preserves existing horizontal + adds dive vector + keeps Y.
    if sideTechAnimPlaying and not prevDiveState then
        local dir
        if autoRushActive then
            local targetPos = rushTargetPos()
            if targetPos then
                local diff = targetPos - hrp.Position
                local flat = Vector3.new(diff.X, 0, diff.Z)
                if flat.Magnitude > 0.5 then
                    dir = flat.Unit
                end
            end
        end
        if not dir then
            dir = diveDirection()
        end

        diveLockedDir = dir

        local base = hrp.AssemblyLinearVelocity
        local horiz = Vector3.new(base.X, 0, base.Z)

        local speed
        if diveBoostEnabled and diveBoostSpeed > 0 then
            speed = diveBoostSpeed
        else
            speed = DIVE_RUSH_BASE_SPEED
        end

        local standingHead = isStandingOnHead()
        if standingHead and rocketBoostEnabled and (math.random() * 100 <= rocketBoostChance) then
            speed = (ROCKET_BOOST_LEVEL - 1) * DIVE_LEVEL_STEP
        end

        hrp.AssemblyLinearVelocity = horiz + dir * speed + Vector3.new(0, base.Y, 0)
    end
    if not sideTechAnimPlaying then
        diveLockedDir = nil
    end
    prevDiveState = sideTechAnimPlaying

    if pullVectorEnabled and isHoldingM1 and not isFlying and not stickyTarget
       and not sideTechAnimPlaying then
        local ball = findFootball()
        local bp = ballPos(ball)
        if bp then
            local direction = bp - hrp.Position
            local currentDistance = direction.Magnitude
            if currentDistance <= 4.5 then
                hrp.AssemblyLinearVelocity = V3_ZERO
            elseif currentDistance > 2 then
                hrp.AssemblyLinearVelocity = direction.Unit * pullSpeed
            end
        end
    end

    if autoRushUnlocked and autoRushActive and autoRushAllowed() and not isFlying and not stickyTarget then
        if sideTechAnimPlaying then
            if diveLockedDir then
                local vel = hrp.AssemblyLinearVelocity
                local horiz = Vector3.new(vel.X, 0, vel.Z)
                local desired = diveLockedDir * math.max(horiz.Magnitude, 1)
                local newHoriz = horiz:Lerp(desired, math.min(dt * 2, 0.15))
                hrp.AssemblyLinearVelocity = Vector3.new(newHoriz.X, vel.Y, newHoriz.Z)
            end
        else
            if humanoid.PlatformStand then humanoid.PlatformStand = false end
            if humanoid.Sit then humanoid.Sit = false end
            if humanoid:GetState() == Enum.HumanoidStateType.Physics then
                pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
            end
            if humanoid.AutoRotate then humanoid.AutoRotate = false end

            local targetPos = rushTargetPos()
            if targetPos then
                local diff = targetPos - hrp.Position
                local flat = Vector3.new(diff.X, 0, diff.Z)
                local flatMag = flat.Magnitude
                if flatMag > 0.1 then
                    local dir = flat / flatMag
                    local speed = walkSpeed
                    if speed < 18 then speed = 18 end
                    local vel = hrp.AssemblyLinearVelocity
                    hrp.AssemblyLinearVelocity = Vector3.new(dir.X * speed, vel.Y, dir.Z * speed)
                    hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + dir)
                end
            end
        end
    elseif autoRushActive and (isFlying or stickyTarget) then
        stopActiveRush()
    end

    if not autoRushActive and humanoid and not humanoid.AutoRotate and not stickyTarget and not sideTechAnimPlaying then
        humanoid.AutoRotate = true
    end

    if isFlying then
        if stickyTarget then detachSticky() end

        if humanoid.PlatformStand then humanoid.PlatformStand = false end
        if humanoid.Sit then humanoid.Sit = false end
        local s = humanoid:GetState()
        if s == Enum.HumanoidStateType.Physics then
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Running) end)
        end

        local move = V3_ZERO
        if UIS:IsKeyDown(Enum.KeyCode.W) then move += camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += camera.CFrame.RightVector end

        local vertical = 0
        if UIS:IsKeyDown(Enum.KeyCode.Space) then vertical = vertical + 1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vertical = vertical - 1 end

        local targetVec = (move.Magnitude > 0) and move.Unit * flySpeed or V3_ZERO
        targetVec = Vector3.new(targetVec.X, vertical * flySpeed * 0.6, targetVec.Z)

        flyVelocity = flyVelocity:Lerp(targetVec, math.min(flyAccel * dt, 1))

        local hv = Vector3.new(flyVelocity.X, 0, flyVelocity.Z)
        if hv.Magnitude > FLY_MAX_VELOCITY then
            hv = hv.Unit * FLY_MAX_VELOCITY
        end
        local vv = math.clamp(flyVelocity.Y, -FLY_VERTICAL_CAP, FLY_VERTICAL_CAP)
        flyVelocity = Vector3.new(hv.X, vv, hv.Z)

        local vel = hrp.AssemblyLinearVelocity
        local newVX = vel.X + (flyVelocity.X - vel.X) * math.min(dt * 8, 1)
        local newVZ = vel.Z + (flyVelocity.Z - vel.Z) * math.min(dt * 8, 1)
        local newVY = vel.Y + (flyVelocity.Y - vel.Y) * math.min(dt * 8, 1)
        if vertical == 0 then
            newVY = newVY + gravityVal * dt * FLY_HOVER_LIFT
        end

        hrp.AssemblyLinearVelocity = Vector3.new(newVX, newVY, newVZ)
    else
        flyVelocity = V3_ZERO
    end

    local hasBall = holdingFootball()

    if stickyHeadEnabled and not isFlying and not hasBall and not sideTechAnimPlaying then
        if stickyTarget then
            local parentChar = stickyTarget.Parent
            local stillAlive = parentChar and parentChar.Parent == workspace
            local targetOK = targetIsMovingNormally(parentChar)
            if stickyReleaseInput or anyMoveKeyDown() or not stillAlive or not targetOK then
                detachSticky()
            end
        end

        if not stickyTarget and stickyCooldown <= 0 and not anyMoveKeyDown() and isAirborne() then
            local jumpedRecently = (now - lastJumpRequestAt) <= JUMP_ATTACH_WINDOW
            if jumpedRecently then
                local head = findNearestHead()
                if head then attachSticky(head) end
            end
        end

        if stickyTarget then
            local offset = headTopOffset(stickyTarget)
            local desired = stickyTarget.CFrame * CFrame.new(offset)
            local elapsed = now - attachTime
            local decay = SMOOTH_DECAY
            if elapsed < EASE_DURATION then
                local t = elapsed / EASE_DURATION
                decay = EASE_DECAY + (SMOOTH_DECAY - EASE_DECAY) * t
            end
            local alpha = 1 - math.exp(-decay * dt)
            local newPos = hrp.Position:Lerp(desired.Position, alpha)
            if elapsed >= EASE_DURATION and (newPos - desired.Position).Magnitude < SNAP_THRESHOLD then
                newPos = desired.Position
            end
            local rot = stickyLockedRotation or (hrp.CFrame - hrp.CFrame.Position)
            hrp.CFrame = CFrame.new(newPos) * rot
            hrp.AssemblyLinearVelocity = V3_ZERO
            hrp.AssemblyAngularVelocity = V3_ZERO
            humanoid:Move(V3_ZERO, false)
            if humanoid.WalkSpeed ~= 0 then humanoid.WalkSpeed = 0 end

            if now >= stickyStateNextCheck then
                stickyStateNextCheck = now + STICKY_STATE_CHECK_INTERVAL
                forceStandingState()
            end
        end
    elseif stickyTarget and (not stickyHeadEnabled or hasBall or isFlying or sideTechAnimPlaying) then
        detachSticky()
    end

    if now - lastHeadLoop >= HEAD_LOOP_INTERVAL then
        lastHeadLoop = now
        runHeadLoop()
    end
end))

