-------------------------------------------------
local function readOrigFromAttr(part)
    local ok, v = pcall(function() return part:GetAttribute(ORIG_SIZE_ATTR) end)
    if not ok or not v then return nil end
    if typeof(v) ~= "Vector3" then return nil end
    return v
end

local function writeOrigToAttr(part, size)
    pcall(function() part:SetAttribute(ORIG_SIZE_ATTR, size) end)
end

local function captureOrig(part)
    if origSizes[part] then return origSizes[part] end
    local persisted = readOrigFromAttr(part)
    if persisted then
        origSizes[part] = persisted
        return persisted
    end
    local s = part.Size
    origSizes[part] = s
    writeOrigToAttr(part, s)
    return s
end

local function applyHeadNow(head)
    if not head or not head.Parent then return end
    local orig = captureOrig(head)
    local targetSize
    if isHeadModEnabled then
        targetSize = Vector3.new(targetHeadScale, orig.Y, targetHeadScale)
    else
        targetSize = orig
    end
    pcall(function()
        if (head.Size - targetSize).Magnitude > SIZE_EPS then head.Size = targetSize end
    end)
    if origCanCollide[head] == nil then
        origCanCollide[head] = head.CanCollide
    end
    if head.CanCollide then
        pcall(function() head.CanCollide = false end)
    end
end

local function applyToAllHeads()
    for i = 1, #cachedPlayers do
        local p = cachedPlayers[i]
        if p ~= localPlayer then
            local c = p.Character
            local h = c and c:FindFirstChild("Head")
            if h then headCache[p] = h; applyHeadNow(h) end
        end
    end
end

-------------------------------------------------
-- HEAD TRANSPARENCY (mode-aware)
-------------------------------------------------
-- Head Extender ON  -> 0.5 (semi)
-- Invisible Heads ON -> 1.0 (full). Wins if both are on.
-- Both OFF          -> restore captured original transparency.
local function desiredHeadTransparency()
    if headsInvisibleEnabled then return 1 end
    if isHeadModEnabled then return HEAD_EXTENDER_TRANSPARENCY end
    return nil
end

local function applyHeadTransparency(head)
    if not head or not head.Parent then return end
    local want = desiredHeadTransparency()
    if want == nil then
        local t = origTransparency[head]
        if t ~= nil then
            pcall(function() head.Transparency = t end)
        end
        return
    end
    if origTransparency[head] == nil then
        origTransparency[head] = head.Transparency
    end
    if head.Transparency ~= want then
        pcall(function() head.Transparency = want end)
    end
end

local function applyTransparencyToAllHeads()
    for i = 1, #cachedPlayers do
        local p = cachedPlayers[i]
        if p ~= localPlayer then
            local head = headCache[p]
            if head and head.Parent then
                applyHeadTransparency(head)
            end
        end
    end
end

