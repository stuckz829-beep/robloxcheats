local function registerToggle(key, obj) uiRefs.toggles[key] = obj end
local function registerSlider(key, obj) uiRefs.sliders[key] = obj end

local function applySettings(data)
    if not data then return end

    local function setToggle(key, value)
        if value == nil then return end
        local obj = uiRefs.toggles[key]
        if obj then pcall(function() obj:Set(value) end) end
    end
    local function setSlider(key, value)
        if value == nil then return end
        local obj = uiRefs.sliders[key]
        if obj then pcall(function() obj:Set(value) end) end
    end

    if type(data.walkSpeed) == "number" then
        walkSpeed = data.walkSpeed
        if humanoid then humanoid.WalkSpeed = walkSpeed end
        setSlider("walkSpeed", data.walkSpeed)
    end
    if type(data.gravityVal) == "number" then
        gravityVal = data.gravityVal
        setSlider("gravityVal", data.gravityVal)
    end
    if type(data.isFlying) == "boolean" then
        isFlying = data.isFlying
        setToggle("isFlying", data.isFlying)
    end
    if type(data.flySpeed) == "number" then
        flySpeed = data.flySpeed
        setSlider("flySpeed", data.flySpeed)
    end
    if type(data.pullVectorEnabled) == "boolean" then
        pullVectorEnabled = data.pullVectorEnabled
        setToggle("pullVectorEnabled", data.pullVectorEnabled)
    end
    if type(data.pullSpeed) == "number" then
        pullSpeed = data.pullSpeed
        setSlider("pullSpeed", data.pullSpeed)
    end
    if type(data.autoRushUnlocked) == "boolean" then
        autoRushUnlocked = data.autoRushUnlocked
        if not autoRushUnlocked then
            if humanoid then pcall(function() humanoid:Move(Vector3.zero, false) end) end
        end
        setToggle("autoRushUnlocked", data.autoRushUnlocked)
    end
    if type(data.isHeadModEnabled) == "boolean" then
        isHeadModEnabled = data.isHeadModEnabled
        for _, p in ipairs(Players:GetPlayers()) do
            if p == localPlayer then continue end
            local c = p.Character
            local h = c and c:FindFirstChild("Head")
            if h then
                headCache[p] = h
                if not origSizes[h] then origSizes[h] = h.Size end
                local orig = origSizes[h]
                local target = isHeadModEnabled
                    and Vector3.new(targetHeadScale, orig.Y, targetHeadScale)
                    or orig
                pcall(function() h.Size = target end)
            end
        end
        setToggle("isHeadModEnabled", data.isHeadModEnabled)
    end
    if type(data.targetHeadScale) == "number" then
        targetHeadScale = data.targetHeadScale
        setSlider("targetHeadScale", data.targetHeadScale)
    end
    if type(data.autoSideTechEnabled) == "boolean" then
        autoSideTechEnabled = data.autoSideTechEnabled
        setToggle("autoSideTechEnabled", data.autoSideTechEnabled)
    end
    if type(data.diveBoostEnabled) == "boolean" then
        diveBoostEnabled = data.diveBoostEnabled
        setToggle("diveBoostEnabled", data.diveBoostEnabled)
    end
    if type(data.diveBoostLevel) == "number" then
        diveBoostLevel = data.diveBoostLevel
        recomputeDiveBoost()
        setSlider("diveBoostLevel", data.diveBoostLevel)
