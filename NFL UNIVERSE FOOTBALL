-------------------------------------------------
-- APPLY SAVED SETTINGS (disk)
-------------------------------------------------
if not priorState then
    task.spawn(function()
        task.wait(0.6)
        if not alive then return end
        if not hasFileApi then
            Rayfield:Notify({Title="Config", Content="No file API on this executor. Auto-save unavailable.", Duration=5})
            return
        end
        local saved = readAutoConfig()
        if not saved then return end
        if not saved.autoLoadEnabled then return end
        applySettings(saved)
        Rayfield:Notify({Title="Config", Content="Auto-loaded last session settings.", Duration=4})
    end)
end

-------------------------------------------------
-- TEARDOWN REGISTRATION (multi-generation)
-------------------------------------------------
local function teardown()
    alive = false
    destroyAllHeadProxies()
    detachStickyTargetJumpConn()
    for inst, t in pairs(origTransparency) do
        pcall(function()
            if inst and inst.Parent then inst.Transparency = t end
        end)
    end
    for head, cc in pairs(origCanCollide) do
        pcall(function()
            if head and head.Parent then head.CanCollide = cc end
        end)
    end
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    conns = {}
    pcall(function() Rayfield:Destroy() end)
end

getgenv()[DESTROY_KEY] = teardown

local registry = getgenv()[TEARDOWN_REGISTRY]
if type(registry) == "table" then
    registry[#registry + 1] = teardown
else
    getgenv()[TEARDOWN_REGISTRY] = {teardown}
end

