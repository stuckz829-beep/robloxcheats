        local p = cachedPlayers[i]
        if p ~= localPlayer and p ~= rec.player then
            local c = p.Character
            if c and c.Parent then
                local h = c:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (h.Position - rec.hrp.Position).Magnitude
                    if d < minD then minD = d end
