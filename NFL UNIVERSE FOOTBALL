local function bindCarrierTracking(char)
    if not char then return end
    track(char.ChildAdded:Connect(function(child)
        if not alive then return end
        if child.Name == FOOTBALL_NAME and char ~= localPlayer.Character then
            ballCarrierChar = char
        end
    end))
    track(char.ChildRemoved:Connect(function(child)
        if not alive then return end
        if child.Name == FOOTBALL_NAME then
            if ballCarrierChar == char then
                ballCarrierChar = nil
            end
            if char ~= localPlayer.Character then
                local bp = ballPos(child)
                if not bp then
                    local ball = findFootball()
                    bp = ballPos(ball)
                end
                if bp then
                    trySwat("ball released", bp)
                end
            end
        end
    end))
    if char:FindFirstChild(FOOTBALL_NAME) and char ~= localPlayer.Character then
        ballCarrierChar = char
    end
end

