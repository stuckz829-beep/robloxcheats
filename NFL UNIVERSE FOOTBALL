local function qbIsGoRoute(rec, myPos)
    local v = rec.hrp.AssemblyLinearVelocity
    local flatV = Vector3.new(v.X, 0, v.Z)
    if flatV.Magnitude < QB_GO_ROUTE_SPEED then return false end
    local toMe = Vector3.new(myPos.X - rec.hrp.Position.X, 0, myPos.Z - rec.hrp.Position.Z)
    if toMe.Magnitude < 0.01 then return false end
